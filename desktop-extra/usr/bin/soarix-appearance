#!/usr/bin/env python3
"""soarix-appearance - wallpaper, light or dark theme, and accent color.

  soarix-appearance          open the Appearance menu
  soarix-appearance apply    at login: apply the saved choices (or the defaults)
  soarix-appearance bar      start the top bar with the chosen accent color (used at login)
  soarix-appearance restart-bar   apply the clock format and accent color to the bar now
  soarix-appearance state | wallpaper PATH | theme dark|light | accent NAME | windows tiled|floating | reset   (for the Appearance window)
"""
import glob
import json
import os
import subprocess
import sys

FUZZEL = "/etc/xdg/fuzzel/fuzzel.ini"
CONF = os.path.expanduser("~/.config/soarix/appearance.json")
BAR_CSS = "/etc/soarix/waybar/style.css"
BAR_USER_CSS = os.path.expanduser("~/.config/soarix/waybar-style.css")
BAR_CONFIG = "/etc/soarix/waybar/config.jsonc"
BAR_USER_CONFIG = os.path.expanduser("~/.config/soarix/waybar-config.jsonc")
DATETIME = os.path.expanduser("~/.config/soarix/datetime.json")
WALLPAPERS = "/usr/share/backgrounds/soarix"
DEFAULT_WALLPAPER = "default.png"
NAMES = {
    "default.png": "SoarixOS (default)",
    "orbit.png": "SOARIX OS, glowing capitals",
    "wide.png": "Wide capitals with a star",
    "readout.png": "Instrument readout",
    "plain.png": "Plain, no text",
    "light.png": "Light",
}
# name, bar color, GNOME accent name (for apps that follow it)
ACCENTS = [("Teal  (default)", "4fb3c8", "teal"), ("Blue", "5b8def", "blue"), ("Green", "5fc27a", "green"),
           ("Yellow", "e0c050", "yellow"), ("Orange", "e08a3c", "orange"), ("Red", "e0605a", "red"),
           ("Pink", "e07aa8", "pink"), ("Purple", "a07be0", "purple"), ("Slate", "8ea2c4", "slate")]


def load():
    try:
        return json.load(open(CONF))
    except (OSError, ValueError):
        return {}


def save(d):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF, "w") as f:
        json.dump(d, f)


def notify(msg):
    subprocess.run(["notify-send", "-a", "Appearance", "Appearance", msg], capture_output=True)


def pick(prompt, items):
    r = subprocess.run(["fuzzel", "--config", FUZZEL, "--dmenu", "-p", prompt + "  ", "-l", str(min(len(items), 14)), "-w", "46"],
                       input="\n".join(items), capture_output=True, text=True)
    s = r.stdout.strip("\n")
    return s if r.returncode == 0 and s else None


def pids(name):
    r = subprocess.run(["pgrep", "-x", name], capture_output=True, text=True)
    return r.stdout.split()


def start(cmd):
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def wallpaper_path(conf):
    w = conf.get("wallpaper") or os.path.join(WALLPAPERS, DEFAULT_WALLPAPER)
    if not os.path.isabs(w):
        w = os.path.join(WALLPAPERS, w)
    return w if os.path.isfile(w) else os.path.join(WALLPAPERS, DEFAULT_WALLPAPER)


def set_wallpaper(path):
    old = pids("swaybg")
    start(["swaybg", "-i", path, "-m", "fill"])
    for p in old:  # remove the old one after the new one is up, so there is no flash
        subprocess.run(["kill", p], capture_output=True)


def accent_of(conf):
    n = conf.get("accent", "teal")
    for label, hexv, gname in ACCENTS:
        if gname == n:
            return hexv, gname
    return ACCENTS[0][1], ACCENTS[0][2]


def gset(key, val):
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", key, val], capture_output=True)


GTK_MARK = "/* Soarix Appearance - gives every GTK app the Soarix look. Remove this line to keep your own edits. */"
# palette: libadwaita (GTK 4) names first, GTK 3 names second
PALETTES = {
    "dark": {"window_bg": "#0b1426", "window_fg": "#e6edf7", "view_bg": "#0f1930", "view_fg": "#e6edf7", "head_bg": "#0b1426",
             "head_fg": "#e6edf7", "card_bg": "#111d36", "pop_bg": "#111d36", "side_bg": "#0f1930", "border": "#22304f",
             "dim_fg": "#6f80a3", "accent_fg": "#0b1426"},
    "light": {"window_bg": "#f3f6fb", "window_fg": "#101a2e", "view_bg": "#ffffff", "view_fg": "#101a2e", "head_bg": "#ffffff",
              "head_fg": "#101a2e", "card_bg": "#ffffff", "pop_bg": "#ffffff", "side_bg": "#e9eef7", "border": "#d3dbe8",
              "dim_fg": "#6a7891", "accent_fg": "#ffffff"},
}


def gtk_css(conf, version):
    p = PALETTES["light" if conf.get("theme") == "light" else "dark"]
    acc = "#" + accent_of(conf)[0]
    n = []
    if version == 4:
        pairs = [("accent_bg_color", acc), ("accent_color", acc), ("accent_fg_color", p["accent_fg"]),
                 ("window_bg_color", p["window_bg"]), ("window_fg_color", p["window_fg"]),
                 ("view_bg_color", p["view_bg"]), ("view_fg_color", p["view_fg"]),
                 ("headerbar_bg_color", p["head_bg"]), ("headerbar_fg_color", p["head_fg"]),
                 ("headerbar_border_color", "#c8963e"), ("headerbar_backdrop_color", p["head_bg"]),
                 ("card_bg_color", p["card_bg"]), ("card_fg_color", p["window_fg"]),
                 ("popover_bg_color", p["pop_bg"]), ("popover_fg_color", p["window_fg"]),
                 ("dialog_bg_color", p["window_bg"]), ("dialog_fg_color", p["window_fg"]),
                 ("sidebar_bg_color", p["side_bg"]), ("sidebar_fg_color", p["window_fg"]),
                 ("secondary_sidebar_bg_color", p["window_bg"]), ("thumbnail_bg_color", p["card_bg"])]
    else:
        pairs = [("theme_bg_color", p["window_bg"]), ("theme_fg_color", p["window_fg"]),
                 ("theme_base_color", p["view_bg"]), ("theme_text_color", p["view_fg"]),
                 ("theme_selected_bg_color", acc), ("theme_selected_fg_color", p["accent_fg"]),
                 ("theme_unfocused_bg_color", p["window_bg"]), ("theme_unfocused_fg_color", p["window_fg"]),
                 ("theme_unfocused_base_color", p["view_bg"]), ("theme_unfocused_text_color", p["view_fg"]),
                 ("theme_unfocused_selected_bg_color", acc), ("theme_unfocused_selected_fg_color", p["accent_fg"]),
                 ("insensitive_bg_color", p["view_bg"]), ("insensitive_fg_color", p["dim_fg"]),
                 ("insensitive_base_color", p["view_bg"]), ("borders", p["border"]), ("unfocused_borders", p["border"]),
                 ("content_view_bg", p["view_bg"]), ("text_view_bg", p["view_bg"]),
                 ("link_color", acc), ("theme_hovering_selected_bg_color", acc),
                 ("bg_color", p["window_bg"]), ("fg_color", p["window_fg"]), ("base_color", p["view_bg"]),
                 ("text_color", p["view_fg"]), ("selected_bg_color", acc), ("selected_fg_color", p["accent_fg"]),
                 ("unfocused_selected_bg_color", acc), ("unfocused_selected_fg_color", p["accent_fg"]),
                 ("tooltip_bg_color", p["card_bg"]), ("tooltip_fg_color", p["window_fg"]),
                 ("warning_color", "#e0c050"), ("error_color", "#e0605a"), ("success_color", "#5fc27a")]
    for name, val in pairs:
        n.append("@define-color %s %s;" % (name, val))
    if version == 3:
        n.append("window, .background, dialog, messagedialog, assistant, window.csd { background-color: %(w)s; color: %(f)s; }" % {"w": p["window_bg"], "f": p["window_fg"]})
        n.append(".view, treeview.view, textview text, iconview, list, list row, scrolledwindow viewport, flowbox { background-color: %(v)s; color: %(vf)s; }" % {"v": p["view_bg"], "vf": p["view_fg"]})
        n.append("row:selected, .view:selected, treeview.view:selected, iconview:selected, flowboxchild:selected { background-color: %(a)s; color: %(af)s; }" % {"a": acc, "af": p["accent_fg"]})
        n.append("entry, spinbutton, combobox button { background-color: %(v)s; color: %(vf)s; border: 1px solid %(b)s; border-radius: 8px; }" % {"v": p["view_bg"], "vf": p["view_fg"], "b": p["border"]})
        n.append("button { background-image: none; background-color: %(c)s; color: %(f)s; border: 1px solid %(b)s; border-radius: 8px; box-shadow: none; text-shadow: none; }" % {"c": p["card_bg"], "f": p["window_fg"], "b": p["border"]})
        n.append("button:hover { background-image: none; border-color: %(a)s; }" % {"a": acc})
        n.append("button:checked, button.suggested-action { background-image: none; background-color: %(a)s; color: %(af)s; }" % {"a": acc, "af": p["accent_fg"]})
        n.append("button:disabled { color: %(d)s; }" % {"d": p["dim_fg"]})
        n.append("menu, .popup, popover, popover.background, tooltip { background-color: %(c)s; color: %(f)s; border: 1px solid %(b)s; }" % {"c": p["card_bg"], "f": p["window_fg"], "b": p["border"]})
        n.append("menuitem:hover, modelbutton:hover { background-color: %(a)s; color: %(af)s; }" % {"a": acc, "af": p["accent_fg"]})
        n.append("notebook > header { background-color: %(w)s; border-color: %(b)s; } notebook > header tab { color: %(d)s; } notebook > header tab:checked { color: %(f)s; box-shadow: inset 0 -3px %(a)s; }" % {"w": p["window_bg"], "b": p["border"], "d": p["dim_fg"], "f": p["window_fg"], "a": acc})
        n.append("scrollbar slider { background-color: %(b)s; border-radius: 6px; }" % {"b": p["dim_fg"]})
        n.append("progressbar progress { background-color: %(a)s; } progressbar trough, scale trough { background-color: %(b)s; }" % {"a": acc, "b": p["border"]})
        n.append("separator { background-color: %(b)s; }" % {"b": p["border"]})
        n.append("notebook, notebook > stack, notebook > stack > box, notebook > stack > grid, paned, toolbar, statusbar, actionbar, infobar, stack > box, stack > grid, .sidebar, placessidebar, viewport > box { background-color: %(w)s; color: %(f)s; }" % {"w": p["window_bg"], "f": p["window_fg"]})
    n.append("headerbar, .titlebar { background: %s; color: %s; border-bottom: 2px solid #c8963e; box-shadow: none; }" % (p["head_bg"], p["head_fg"]))
    return GTK_MARK + "\n" + "\n".join(n) + "\n"


def write_gtk_css(conf):
    """Every GTK app reads these two files. Files the person wrote themselves (no mark) are left alone."""
    for ver in (3, 4):
        d = os.path.expanduser("~/.config/gtk-%d.0" % ver)
        f = os.path.join(d, "gtk.css")
        try:
            if os.path.exists(f) and not open(f).read().startswith(GTK_MARK):
                continue
            os.makedirs(d, exist_ok=True)
            with open(f, "w") as fh:
                fh.write(gtk_css(conf, ver))
        except OSError:
            pass
    ini = os.path.expanduser("~/.config/gtk-3.0/settings.ini")
    try:
        if not os.path.exists(ini) or open(ini).read().startswith("# Soarix"):
            with open(ini, "w") as fh:
                fh.write("# Soarix Appearance (remove this line to keep your own edits)\n[Settings]\ngtk-application-prefer-dark-theme=%d\n"
                         % (0 if conf.get("theme") == "light" else 1))
    except OSError:
        pass


def set_theme(conf):
    dark = conf.get("theme", "dark") != "light"
    gset("color-scheme", "'prefer-dark'" if dark else "'prefer-light'")
    gset("accent-color", "'%s'" % accent_of(conf)[1])
    write_gtk_css(conf)


def bar_css(conf):
    hexv = accent_of(conf)[0]
    css = open(BAR_CSS).read()
    css += ("\n/* accent color chosen in Appearance */\n"
            "#custom-store, #workspaces button.active, #workspaces button.focused { background: #%s; }\n"
            "#taskbar button.active { border-bottom: 3px solid #%s; }\n" % (hexv, hexv))
    os.makedirs(os.path.dirname(BAR_USER_CSS), exist_ok=True)
    with open(BAR_USER_CSS, "w") as f:
        f.write(css)
    return BAR_USER_CSS


def dt_setting(key, default):
    try:
        return json.load(open(DATETIME)).get(key, default)
    except (OSError, ValueError):
        return default


def clock24():
    return bool(dt_setting("clock24", False))


def bar_config():
    """The bar settings with the clock in the chosen format (12-hour by default, or 24-hour)."""
    d = json.load(open(BAR_CONFIG))
    # The bar understands standard date codes only (no "%-d" style), so the day uses %e (space padded)
    if clock24():
        d["clock"]["format"] = "{:%a %b %e   %H:%M}"
    else:
        d["clock"]["format"] = "{:%a %b %e   %I:%M %p}"
    d["clock"]["tooltip-format"] = "{:%A, %B %e, %Y}"
    if not dt_setting("show_clock", True) and "clock" in d.get("modules-right", []):
        d["modules-right"].remove("clock")
    os.makedirs(os.path.dirname(BAR_USER_CONFIG), exist_ok=True)
    with open(BAR_USER_CONFIG, "w") as f:
        json.dump(d, f, indent=2)
    return BAR_USER_CONFIG


def set_clock_format():
    gset("clock-format", "'24h'" if clock24() else "'12h'")


def bar_command(conf):
    return ["waybar", "-c", bar_config(), "-s", bar_css(conf)]


def restart_bar(conf):
    for p in pids("waybar"):
        subprocess.run(["kill", p], capture_output=True)
    start(bar_command(conf))


def apply_all():
    conf = load()
    set_theme(conf)
    set_clock_format()
    if windows_mode(conf) == "floating":
        start_float_daemon()
    if conf.get("wallpaper") and wallpaper_path(conf) != os.path.join(WALLPAPERS, DEFAULT_WALLPAPER):
        set_wallpaper(wallpaper_path(conf))
    return 0


FLOAT_CMD = ["soarix-appearance", "float-daemon"]


def niri(*args):
    return subprocess.run(["niri", "msg"] + list(args), capture_output=True, text=True)


def windows_mode(conf):
    return "floating" if conf.get("windows") == "floating" else "tiled"


def handle_event(line, seen, float_one):
    """One line of 'niri msg --json event-stream': float every window the first time it appears."""
    try:
        ev = json.loads(line)
    except ValueError:
        return
    if "WindowsChanged" in ev:
        for w in ev["WindowsChanged"].get("windows", []):
            seen.add(w["id"])
    elif "WindowOpenedOrChanged" in ev:
        w = ev["WindowOpenedOrChanged"].get("window", {})
        if w.get("id") is not None and w["id"] not in seen:
            seen.add(w["id"])
            if not w.get("is_floating"):
                float_one(w["id"])


def float_daemon():
    """Runs for the whole session while 'floating' is chosen: new windows open floating (overlapping)."""
    import time
    while windows_mode(load()) == "floating":
        seen = set()
        try:
            p = subprocess.Popen(["niri", "msg", "--json", "event-stream"], stdout=subprocess.PIPE, text=True)
            for line in p.stdout:
                if windows_mode(load()) != "floating":
                    p.terminate()
                    return 0
                handle_event(line, seen, lambda i: niri("action", "move-window-to-floating", "--id", str(i)))
        except OSError:
            pass
        time.sleep(2)
    return 0


def start_float_daemon():
    if subprocess.run(["pgrep", "-f", "soarix-appearance float-daemon"], capture_output=True).returncode != 0:
        start(FLOAT_CMD)


def set_windows(mode):
    """Choose how windows open: side by side (tiled) or overlapping (floating). Windows already open switch too."""
    conf = load()
    conf["windows"] = mode
    save(conf)
    try:
        wins = json.loads(niri("--json", "windows").stdout or "[]")
    except ValueError:
        wins = []
    if mode == "floating":
        start_float_daemon()
        for w in wins:
            if not w.get("is_floating"):
                niri("action", "move-window-to-floating", "--id", str(w["id"]))
    else:
        subprocess.run(["pkill", "-f", "soarix-appearance float-daemon"], capture_output=True)
        for w in wins:
            if w.get("is_floating"):
                niri("action", "move-window-to-tiling", "--id", str(w["id"]))


def wallpaper_list():
    out = []
    for f in sorted(glob.glob(os.path.join(WALLPAPERS, "*.png"))):
        b = os.path.basename(f)
        out.append({"path": f, "name": NAMES.get(b, os.path.splitext(b)[0])})
    pics = (glob.glob(os.path.expanduser("~/Pictures/*.png")) + glob.glob(os.path.expanduser("~/Pictures/*.jpg")) +
            glob.glob(os.path.expanduser("~/Pictures/*.jpeg")))
    for f in sorted(pics):
        out.append({"path": f, "name": "My picture: " + os.path.basename(f)})
    return out


def state_json():
    conf = load()
    return {"wallpapers": wallpaper_list(), "wallpaper": wallpaper_path(conf), "theme": conf.get("theme", "dark"),
            "accent": accent_of(conf)[1], "windows": windows_mode(conf),
            "accents": [{"name": g, "label": l.split()[0], "hex": h} for l, h, g in ACCENTS]}


def choose_wallpaper():
    conf = load()
    items, paths = [], {}
    for f in sorted(glob.glob(os.path.join(WALLPAPERS, "*.png"))):
        b = os.path.basename(f)
        label = NAMES.get(b, os.path.splitext(b)[0])
        if f == wallpaper_path(conf):
            label += "   (now)"
        items.append(label)
        paths[label] = f
    pics = sorted(glob.glob(os.path.expanduser("~/Pictures/*.png")) + glob.glob(os.path.expanduser("~/Pictures/*.jpg")) +
                  glob.glob(os.path.expanduser("~/Pictures/*.jpeg")))
    for f in pics:
        label = "My picture: " + os.path.basename(f)
        items.append(label)
        paths[label] = f
    if not pics:
        items.append("(To use your own picture, put it in your Pictures folder, then open this again)")
    items.append("Back")
    c = pick("Wallpaper", items)
    if not c or c == "Back" or c not in paths:
        return
    conf["wallpaper"] = paths[c]
    save(conf)
    set_wallpaper(paths[c])
    notify("Wallpaper changed. It will be used every time you sign in.")


def choose_theme():
    conf = load()
    now = conf.get("theme", "dark")
    c = pick("Theme", ["Dark" + ("   (now)" if now == "dark" else ""), "Light" + ("   (now)" if now == "light" else ""), "Back"])
    if not c or c == "Back":
        return
    conf["theme"] = "light" if c.startswith("Light") else "dark"
    save(conf)
    set_theme(conf)
    notify("Theme changed. Apps that are already open may need to be reopened.")


def choose_accent():
    conf = load()
    now = accent_of(conf)[1]
    items = [label + ("   (now)" if g == now and "(default)" not in label else "") for label, _, g in ACCENTS] + ["Back"]
    c = pick("Accent color", items)
    if not c or c == "Back":
        return
    for label, _, g in ACCENTS:
        if c.startswith(label):
            conf["accent"] = g
    save(conf)
    set_theme(conf)
    restart_bar(conf)
    notify("Accent color changed.")


def reset():
    try:
        os.remove(CONF)
    except OSError:
        pass
    conf = {}
    set_theme(conf)
    set_wallpaper(wallpaper_path(conf))
    restart_bar(conf)
    notify("Appearance reset to the Soarix defaults.")


def menu():
    while True:
        conf = load()
        theme = "Light" if conf.get("theme") == "light" else "Dark"
        wp = NAMES.get(os.path.basename(wallpaper_path(conf)), os.path.basename(wallpaper_path(conf)))
        accent = next(l.split()[0] for l, _, g in ACCENTS if g == accent_of(conf)[1])
        c = pick("Appearance", ["Wallpaper:  " + wp, "Theme:  " + theme, "Accent color:  " + accent,
                                "Reset to the Soarix defaults", "Close"])
        if c and c.startswith("Wallpaper"):
            choose_wallpaper()
        elif c and c.startswith("Theme"):
            choose_theme()
        elif c and c.startswith("Accent"):
            choose_accent()
        elif c and c.startswith("Reset"):
            reset()
        else:
            return 0


if __name__ == "__main__":
    a = sys.argv[1:]
    if a == ["apply"]:
        sys.exit(apply_all())
    if a == ["state"]:
        print(json.dumps(state_json()))
        sys.exit(0)
    if a == ["float-daemon"]:
        sys.exit(float_daemon())
    if len(a) == 2 and a[0] == "windows" and a[1] in ("tiled", "floating"):
        set_windows(a[1])
        sys.exit(0)
    if len(a) == 2 and a[0] == "wallpaper" and os.path.isfile(a[1]):
        conf = load()
        conf["wallpaper"] = a[1]
        save(conf)
        set_wallpaper(a[1])
        sys.exit(0)
    if len(a) == 2 and a[0] == "theme" and a[1] in ("dark", "light"):
        conf = load()
        conf["theme"] = a[1]
        save(conf)
        set_theme(conf)
        sys.exit(0)
    if len(a) == 2 and a[0] == "accent" and a[1] in [g for _, _, g in ACCENTS]:
        conf = load()
        conf["accent"] = a[1]
        save(conf)
        set_theme(conf)
        restart_bar(conf)
        sys.exit(0)
    if a == ["reset"]:
        if windows_mode(load()) == "floating":
            set_windows("tiled")
        try:
            os.remove(CONF)
        except OSError:
            pass
        set_theme({})
        set_wallpaper(wallpaper_path({}))
        restart_bar({})
        sys.exit(0)
    if a == ["restart-bar"]:
        set_clock_format()
        restart_bar(load())
        sys.exit(0)
    if a == ["bar"]:
        c = bar_command(load())
        os.execvp(c[0], c)
    sys.exit(menu())
