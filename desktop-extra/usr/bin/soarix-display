#!/usr/bin/python3
"""soarix-display - screen resolution and size of text/icons for the Soarix desktop.

  soarix-display          open the Display Settings menu
  soarix-display apply    at login: apply the saved choice, or a sensible default in a virtual machine
  soarix-display lock     lock the screen now
  soarix-display idle     at login: lock and turn the screen off after the chosen times
  soarix-display state | mode WxH | scale N | keep | lock-after N | off-after N | reset   (for the Display Settings window)

A new setting is kept only after you confirm it. If the screen goes blank or unreadable, wait
15 seconds and the previous setting comes back by itself.
"""
import json
import os
import subprocess
import sys
import time

FUZZEL = "/etc/xdg/fuzzel/fuzzel.ini"
CONF = os.path.expanduser("~/.config/soarix/display.json")
SCALES = [("100%  (default)", 1.0), ("125%", 1.25), ("150%", 1.5), ("175%", 1.75), ("200%  (large, for 4K screens)", 2.0)]
APPEARANCE = os.path.expanduser("~/.config/soarix/appearance.json")
LOCK_CSS = os.path.expanduser("~/.config/soarix/lock.css")
WALLPAPER = "/usr/share/backgrounds/soarix/default.png"
ACCENT_HEX = {"teal": "4fb3c8", "blue": "5b8def", "green": "5fc27a", "yellow": "e0c050", "orange": "e08a3c",
              "red": "e0605a", "pink": "e07aa8", "purple": "a07be0", "slate": "8ea2c4"}
# lock the screen after 15 minutes, turn it off after 30 (the screen saver); 0 means never
DESK_DEFAULTS = {"lock": 15, "off": 30}
MINUTES = [("Never", 0), ("1 minute", 1), ("2 minutes", 2), ("5 minutes", 5), ("10 minutes", 10),
           ("15 minutes", 15), ("30 minutes", 30), ("1 hour", 60)]


def niri(*args):
    return subprocess.run(["niri", "msg", *args], capture_output=True, text=True)


def outputs():
    r = niri("--json", "outputs")
    try:
        return json.loads(r.stdout) if r.returncode == 0 else {}
    except ValueError:
        return {}


def in_vm():
    return subprocess.run(["systemd-detect-virt", "-q"], capture_output=True).returncode == 0


def notify(msg):
    subprocess.run(["notify-send", "-a", "Display Settings", "Display Settings", msg], capture_output=True)


def load():
    try:
        return json.load(open(CONF))
    except (OSError, ValueError):
        return {}


def save(d):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF, "w") as f:
        json.dump(d, f)


def cur(o):
    """(width, height, scale) now in use"""
    i = o.get("current_mode")
    m = o["modes"][i] if i is not None else o["modes"][0]
    return m["width"], m["height"], float((o.get("logical") or {}).get("scale", 1.0))


def resolutions(o):
    seen = {}
    for m in o["modes"]:
        seen[(m["width"], m["height"])] = True
    return sorted(seen, key=lambda r: (r[0] * r[1], r[0]), reverse=True)


def set_mode(name, w, h):
    return niri("output", name, "mode", "%dx%d" % (w, h)).returncode == 0


def set_scale(name, s):
    return niri("output", name, "scale", ("%g" % s)).returncode == 0


def best_for_vm(o):
    """A virtual screen often offers 4K, which is slow to draw without a GPU: prefer 1920x1080."""
    fit = [r for r in resolutions(o) if r[0] <= 1920 and r[1] <= 1080]
    return fit[0] if fit else None


def pick(prompt, items):
    r = subprocess.run(["fuzzel", "--config", FUZZEL, "--dmenu", "-p", prompt + "  ", "-l", str(min(len(items), 14)), "-w", "46"],
                       input="\n".join(items), capture_output=True, text=True)
    s = r.stdout.strip("\n")
    return s if r.returncode == 0 and s else None


def confirm():
    r = subprocess.run(["timeout", "15", "fuzzel", "--config", FUZZEL, "--dmenu", "-p", "Keep this setting?  ", "-l", "2", "-w", "46"],
                       input="Keep this setting\nGo back to the old one\n", capture_output=True, text=True)
    return r.stdout.strip() == "Keep this setting"


def apply_saved():
    conf = load()
    # at login the screen may not be listed yet: wait for it (up to 15 seconds)
    outs = outputs()
    for _ in range(15):
        if outs:
            break
        time.sleep(1)
        outs = outputs()
    for name, o in outs.items():
        s = conf.get(name)
        if s:
            if s.get("size"):
                set_mode(name, *s["size"])
            if s.get("scale"):
                set_scale(name, s["scale"])
        elif in_vm():
            w, h, _ = cur(o)
            if w > 2560 or h > 1440:
                best = best_for_vm(o)
                if best:
                    set_mode(name, *best)
    return 0


def change(name, o, what):
    w0, h0, s0 = cur(o)
    if what == "res":
        items = []
        for r in resolutions(o):
            tag = "   (now)" if r == (w0, h0) else ""
            items.append("%d x %d%s" % (r[0], r[1], tag))
        c = pick("Resolution", items)
        if not c:
            return
        w, h = [int(x) for x in c.split("(")[0].replace("x", " ").split()]
        ok = set_mode(name, w, h)
    else:
        c = pick("Text and icon size", [t for t, _ in SCALES])
        if not c:
            return
        ok = set_scale(name, dict(SCALES)[c])
    if not ok:
        notify("That setting was not accepted by the screen.")
        return
    if confirm():
        conf = load()
        n1 = outputs().get(name)
        if n1:
            w, h, s = cur(n1)
            conf[name] = {"size": [w, h], "scale": s}
            save(conf)
        notify("Saved. It will be used every time you sign in.")
    else:
        set_mode(name, w0, h0)
        set_scale(name, s0)


def reset(outs):
    try:
        os.remove(CONF)
    except OSError:
        pass
    for name, o in outs.items():
        pref = [m for m in o["modes"] if m.get("is_preferred")]
        target = best_for_vm(o) if in_vm() else ((pref[0]["width"], pref[0]["height"]) if pref else None)
        if target:
            set_mode(name, *target)
        set_scale(name, 1.0)
    notify("Display settings reset.")


def menu():
    outs = outputs()
    if not outs:
        notify("Could not read the screen list. Is the desktop running?")
        return 1
    name = next(iter(outs))
    if len(outs) > 1:
        label = {"%s  (%s)" % (n, " ".join(filter(None, [o.get("make"), o.get("model")]))): n for n, o in outs.items()}
        c = pick("Screen", list(label))
        if not c:
            return 0
        name = label[c]
    while True:
        o = outputs()[name]
        w, h, s = cur(o)
        d = desk()
        c = pick("Display  (%d x %d, %d%%)" % (w, h, round(s * 100)),
                 ["Resolution", "Text and icon size",
                  "Lock the screen after:  " + minutes_label(d["lock"]),
                  "Screen saver (turns the screen off) after:  " + minutes_label(d["off"]),
                  "Lock the screen now",
                  "Reset to the recommended setting", "Close"])
        if c == "Resolution":
            change(name, o, "res")
        elif c == "Text and icon size":
            change(name, o, "scale")
        elif c and c.startswith("Lock the screen after"):
            choose_minutes("Lock the screen after", "lock")
        elif c and c.startswith("Screen saver"):
            choose_minutes("Turn the screen off after", "off")
        elif c == "Lock the screen now":
            start(["soarix-display", "lock"])
            return 0
        elif c and c.startswith("Reset"):
            reset(outputs())
        else:
            return 0


def start(cmd):
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def desk():
    d = dict(DESK_DEFAULTS)
    d.update({k: v for k, v in (load().get("_desktop") or {}).items() if k in d and isinstance(v, int)})
    return d


def minutes_label(m):
    for label, v in MINUTES:
        if v == m:
            return label
    return "%d minutes" % m


def choose_minutes(prompt, key):
    now = desk()[key]
    c = pick(prompt, [label + ("   (now)" if v == now else "") for label, v in MINUTES] + ["Back"])
    if not c or c == "Back":
        return
    for label, v in MINUTES:
        if c.startswith(label):
            conf = load()
            d = conf.setdefault("_desktop", {})
            d[key] = v
            save(conf)
            restart_idle()
            notify("Saved. It will be used every time you sign in.")


def idle_command():
    d = desk()
    cmd = ["swayidle", "-w"]
    if d["lock"]:
        cmd += ["timeout", str(d["lock"] * 60), "soarix-display lock"]
    if d["off"]:
        cmd += ["timeout", str(d["off"] * 60), "niri msg action power-off-monitors", "resume", "niri msg action power-on-monitors"]
    return cmd + ["before-sleep", "soarix-display lock"]


def restart_idle():
    subprocess.run(["pkill", "-x", "swayidle"], capture_output=True)
    start(idle_command())


def lock_css():
    try:
        a = json.load(open(APPEARANCE))
    except (OSError, ValueError):
        a = {}
    wp = a.get("wallpaper") or WALLPAPER
    if not os.path.isfile(wp):
        wp = WALLPAPER
    accent = ACCENT_HEX.get(a.get("accent", "teal"), "4fb3c8")
    css = (
        'window { background-image: linear-gradient(rgba(8,14,28,0.55), rgba(8,14,28,0.55)), url("file://%s");'
        ' background-size: cover; background-position: center; color: #e6edf7; font-family: "Noto Sans", sans-serif; }\n'
        '#clock-label { font-size: 110px; font-weight: 300; }\n'
        '#input-field { border-radius: 10px; border: 2px solid #%s; background: rgba(11,20,38,0.88); color: #e6edf7; padding: 8px 12px; }\n'
        '#input-label, #error-label { color: #%s; }\n'
        '#unlock-button { border-radius: 10px; background: #%s; color: #0b1426; }\n' % (wp, accent, accent, accent))
    os.makedirs(os.path.dirname(LOCK_CSS), exist_ok=True)
    with open(LOCK_CSS, "w") as f:
        f.write(css)
    return LOCK_CSS


def lock():
    if subprocess.run(["pgrep", "-x", "gtklock"], capture_output=True).returncode == 0:
        return 0
    try:
        dt = json.load(open(os.path.expanduser("~/.config/soarix/datetime.json")))
    except (OSError, ValueError):
        dt = {}
    tf = "%H:%M" if dt.get("clock24") else "%-I:%M %p"
    started = time.time()
    try:
        rc = subprocess.run(["gtklock", "--style", lock_css(), "--time-format", tf, "--date-format", "%A, %B %-d"]).returncode
    except OSError:
        rc = 127
    if rc != 0 and time.time() - started < 3:  # the lock screen did not start: use the plain one
        os.execvp("swaylock", ["swaylock", "-f", "-c", "0b1426"])
    return 0


def first_output():
    outs = outputs()
    if not outs:
        return None, None
    name = next(iter(outs))
    return name, outs[name]


def state_json():
    name, o = first_output()
    d = desk()
    out = {"output": name, "lock": d["lock"], "off": d["off"], "minutes": MINUTES,
           "scales": [[t, v] for t, v in SCALES]}
    if o:
        w, h, s = cur(o)
        out.update({"width": w, "height": h, "scale": s, "resolutions": [list(r) for r in resolutions(o)]})
    return out


def save_current():
    name, o = first_output()
    if not o:
        return 1
    w, h, s = cur(o)
    conf = load()
    conf[name] = {"size": [w, h], "scale": s}
    save(conf)
    return 0


def set_minutes(key, value):
    conf = load()
    conf.setdefault("_desktop", {})[key] = int(value)
    save(conf)
    restart_idle()
    return 0


if __name__ == "__main__":
    a = sys.argv[1:]
    if a == ["state"]:
        print(json.dumps(state_json()))
        sys.exit(0)
    if len(a) == 2 and a[0] == "mode" and a[1].count("x") == 1:
        name, o = first_output()
        w, h = [int(x) for x in a[1].split("x")]
        sys.exit(0 if name and set_mode(name, w, h) else 1)
    if len(a) == 2 and a[0] == "scale":
        name, o = first_output()
        sys.exit(0 if name and set_scale(name, float(a[1])) else 1)
    if a == ["keep"]:
        sys.exit(save_current())
    if len(a) == 2 and a[0] in ("lock-after", "off-after") and a[1].isdigit():
        sys.exit(set_minutes("lock" if a[0] == "lock-after" else "off", a[1]))
    if a == ["reset"]:
        reset(outputs())
        sys.exit(0)
    if a == ["apply"]:
        sys.exit(apply_saved())
    if a == ["lock"]:
        sys.exit(lock())
    if a == ["idle"]:
        c = idle_command()
        os.execvp(c[0], c)
    sys.exit(menu())
