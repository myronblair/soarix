#!/usr/bin/sh
# soarix-session - starts the Soarix desktop (niri) under systemd --user.
# Same job as niri-session, but it hands systemd an explicit list of variables, so the login
# no longer prints the "import-environment without a list of variable names is deprecated" warning.

# Run once inside the user's login shell so the profile (PATH etc.) applies
if [ "$1" != '-l' ] && [ -n "$SHELL" ] && grep -q "$SHELL" /etc/shells \
   && ! echo "$SHELL" | grep -qE 'false|nologin'; then
    exec bash -c "exec -l '$SHELL' -c '$0 -l'"
fi

if systemctl --user -q is-active niri.service; then
    echo 'A Soarix desktop session is already running.'
    exit 1
fi
systemctl --user reset-failed

VARS=""
for v in PATH HOME USER LOGNAME SHELL LANG LANGUAGE XDG_SEAT XDG_SESSION_ID XDG_SESSION_TYPE \
         XDG_SESSION_CLASS XDG_SESSION_DESKTOP XDG_VTNR XDG_RUNTIME_DIR XDG_DATA_DIRS XDG_CONFIG_DIRS; do
    eval "[ -n \"\${$v+x}\" ]" && VARS="$VARS $v"
done
# shellcheck disable=SC2086
systemctl --user import-environment $VARS
command -v dbus-update-activation-environment >/dev/null 2>&1 && dbus-update-activation-environment $VARS

systemctl --user --wait start niri.service
systemctl --user start --job-mode=replace-irreversibly niri-shutdown.target
systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP NIRI_SOCKET
