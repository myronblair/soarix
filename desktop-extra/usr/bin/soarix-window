#!/bin/bash
# soarix-window - open one of the Soarix tools in a terminal window (used by the app drawer,
# whose launcher lines cannot contain quotes).

update_menu() {
  local c a
  while :; do
    clear
    echo
    echo "  Soarix Update"
    echo "  -------------"
    echo "   1) See what I am running, and whether an update is waiting"
    echo "   2) Update everything (Soarix and my apps)"
    echo "   3) Update only my apps"
    echo "   4) Update only Soarix"
    echo "   5) Go back to the previous version of Soarix"
    echo "   q) Close"
    echo
    printf "  > "
    read -r c
    case "$c" in
      1) sudo soarix-update status ;;
      2) sudo soarix-update all; a=restart ;;
      3) sudo soarix-update apps ;;
      4) sudo soarix-update os; a=restart ;;
      5) sudo soarix-update rollback; a=restart ;;
      q|Q|"") [ -z "$c" ] && continue; exit 0 ;;
      *) continue ;;
    esac
    echo
    if [ "$a" = restart ]; then
      read -rp "  Restart now to use a new version of Soarix? [y/N] " r
      [ "$r" = y ] || [ "$r" = Y ] && exec sudo systemctl reboot
      a=
    fi
    read -rp "  Press Enter to go back to the menu "
  done
}

# The graphical windows need GTK; fall back to the terminal versions if it is missing
if [ "$1" = update ] || [ "$1" = license ] || [ "$1" = essentials ] || [ "$1" = datetime ] || [ "$1" = sysinfo ] || [ "$1" = services ] || [ "$1" = appearance ] || [ "$1" = display ] || [ "$1" = network ] || [ "$1" = printers ] || [ "$1" = devices ] || [ "$1" = users ] || [ "$1" = addons ]; then
  if command -v soarix-app >/dev/null && python3 -c 'import gi; gi.require_version("Gtk", "4.0")' 2>/dev/null; then
    exec soarix-app "$1"
  fi
fi

case "$1" in
  update)     exec foot -T "Soarix Update" soarix-window update-menu ;;
  update-menu) update_menu ;;
  license)    exec foot -T "Soarix License" sh -c 'sudo soarix-license status; echo; read -rp "Press Enter to close "' ;;
  essentials) exec foot -T "Soarix Essentials" soarix-essentials ;;
  addons)     exec foot -T "Add-ons" sh -c 'soarix-addon list; echo; read -rp "Press Enter to close "' ;;
  users)      exec xdg-open https://localhost:9090/users ;;
  devices)    exec foot -T "Network Devices" arp -a ;;
  network)    exec foot -T "Network" nmtui ;;
  printers)   exec system-config-printer ;;
  appearance) exec soarix-appearance ;;
  display)    exec soarix-display ;;
  console)
    # Firefox can take a while to start on a small computer: say so, and explain the certificate notice
    notify-send -a Soarix "Soarix Web Console" "Opening in the browser. This can take a few seconds. If Firefox warns about the certificate, choose Advanced, then Accept the Risk and Continue: it is your own computer." 2>/dev/null
    exec firefox --new-window https://localhost:9090 ;;
  services)   exec foot -T "Server Services" sh -c 'soarix-server list; echo; read -rp "Press Enter to close "' ;;
  sysinfo)    exec foot -T "System Information" sh -c 'soarix-info; echo; read -rp "Press Enter to close "' ;;
  datetime)   exec foot -T "Date and Time" sh -c 'timedatectl; echo; read -rp "Press Enter to close "' ;;
  *) echo "usage: soarix-window update|license|essentials|datetime|sysinfo|services|console|appearance|display|network|printers|devices|users|addons" >&2; exit 2 ;;
esac
