#!/bin/bash
# soarix-window - open one of the Soarix tools in a terminal window (used by the app drawer,
# whose launcher lines cannot contain quotes).

update_menu() {
  local c a
  while :; do
    clear
    echo
    echo "  Soarix Update"
    echo "  -------------"
    echo "   1) See what I am running, and whether an update is waiting"
    echo "   2) Update everything (Soarix and my apps)"
    echo "   3) Update only my apps"
    echo "   4) Update only Soarix"
    echo "   5) Go back to the previous version of Soarix"
    echo "   q) Close"
    echo
    printf "  > "
    read -r c
    case "$c" in
      1) sudo soarix-update status ;;
      2) sudo soarix-update all; a=restart ;;
      3) sudo soarix-update apps ;;
      4) sudo soarix-update os; a=restart ;;
      5) sudo soarix-update rollback; a=restart ;;
      q|Q|"") [ -z "$c" ] && continue; exit 0 ;;
      *) continue ;;
    esac
    echo
    if [ "$a" = restart ]; then
      read -rp "  Restart now to use a new version of Soarix? [y/N] " r
      [ "$r" = y ] || [ "$r" = Y ] && exec sudo systemctl reboot
      a=
    fi
    read -rp "  Press Enter to go back to the menu "
  done
}

case "$1" in
  update)     exec foot -T "Soarix Update" soarix-window update-menu ;;
  update-menu) update_menu ;;
  license)    exec foot -T "Soarix License" sh -c 'sudo soarix-license status; echo; read -rp "Press Enter to close "' ;;
  essentials) exec foot -T "Soarix Essentials" soarix-essentials ;;
  *) echo "usage: soarix-window update|license|essentials" >&2; exit 2 ;;
esac
