def os_release():
    d = {}
    try:
        for ln in open("/usr/lib/os-release"):
            if "=" in ln:
                k, v = ln.rstrip().split("=", 1)
                d[k] = v.strip('"')
    except OSError:
        pass
    return d


def mk(widget, *classes):
    for c in classes:
        widget.add_css_class(c)
    return widget


def label(text, *classes, xalign=0.0, wrap=False):
    lb = Gtk.Label(label=text, xalign=xalign)
    lb.set_wrap(wrap)
    if wrap:
        lb.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
    return mk(lb, *classes)


class Runner:
    """Runs a command in the background (with administrator rights when asked) and streams its output."""

    def __init__(self, win):
        self.win = win

    def run(self, cmd, on_line, on_done, admin=False, password=None):
        def work():
            full = (["sudo", "-S", "-p", ""] + cmd) if admin else cmd
            try:
                p = subprocess.Popen(full, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                     env=dict(os.environ, LC_ALL="C.UTF-8", TERM="dumb"))
            except OSError as e:
                GLib.idle_add(on_done, 127, str(e))
                return
            try:
                if admin:
                    p.stdin.write(((password or "") + "\n").encode())
                p.stdin.close()
            except OSError:
                pass
            buf = ""
            while True:
                chunk = os.read(p.stdout.fileno(), 4096)
                if not chunk:
                    break
                buf += ANSI.sub("", chunk.decode("utf-8", "replace"))
                parts = re.split(r"[\r\n]", buf)
                buf = parts.pop()
                for ln in parts:
                    if ln.strip():
                        GLib.idle_add(on_line, ln.rstrip(), False)
                if buf.strip():
                    GLib.idle_add(on_line, buf.strip(), True)
            rc = p.wait()
            GLib.idle_add(on_done, rc, "")
        threading.Thread(target=work, daemon=True).start()


class PasswordBox(Gtk.Window):
    """A Soarix-style box that asks for the password of the signed-in user."""

    def __init__(self, parent, why, on_ok):
        super().__init__(transient_for=parent, modal=True, title="Administrator password")
        mk(self, "soarix-dialog")
        self.on_ok = on_ok
        self.set_default_size(420, -1)
        self.set_resizable(False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        for m in ("top", "bottom", "start", "end"):
            getattr(box, "set_margin_" + m)(24)
        box.append(label("Password needed", "heading"))
        box.append(label(why, "sub", wrap=True))
        self.entry = Gtk.PasswordEntry(show_peek_icon=True)
        self.entry.connect("activate", self.go)
        box.append(self.entry)
        self.msg = label("", "bad")
        box.append(self.msg)
        row = Gtk.Box(spacing=10, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda *_: self.close())
        self.ok = mk(Gtk.Button(label="Continue"), "primary")
        self.ok.connect("clicked", self.go)
        row.append(cancel)
        row.append(self.ok)
        box.append(row)
        self.set_child(box)
        self.entry.grab_focus()

    def go(self, *_):
        pw = self.entry.get_text()
        if not pw:
            return
        self.ok.set_sensitive(False)
        self.msg.set_text("Checking ...")

        def check():
            try:
                p = subprocess.run(["sudo", "-S", "-p", "", "-v"], input=(pw + "\n").encode(), capture_output=True, timeout=30)
                good = p.returncode == 0
            except (OSError, subprocess.TimeoutExpired):
                good = False
            GLib.idle_add(self.done, good, pw)
        threading.Thread(target=check, daemon=True).start()

    def done(self, good, pw):
        if good:
            self.close()
            self.on_ok(pw)
        else:
            self.ok.set_sensitive(True)
            self.msg.set_text("That password did not work. Try again.")
            self.entry.set_text("")
            self.entry.grab_focus()


class Page(Gtk.ApplicationWindow):
    TITLE = "Soarix"
    SIZE = (780, 640)

    def __init__(self, app):
        super().__init__(application=app, title=self.TITLE)
        mk(self, "soarix")
        self.set_default_size(*self.SIZE)
        self.password = None
        self.runner = Runner(self)
        hb = Gtk.HeaderBar()
        self.set_titlebar(hb)
        self.root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        for m in ("top", "bottom", "start", "end"):
            getattr(self.root, "set_margin_" + m)(22)
        self.set_child(self.root)
        self.connect("close-request", self.on_close)

    def on_close(self, *_):
        self.password = None
        return False

    def head(self, title, sub):
        row = Gtk.Box(spacing=16)
        img = Gtk.Image.new_from_icon_name("soarix")
        img.set_pixel_size(56)
        row.append(img)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, valign=Gtk.Align.CENTER)
        col.append(label(title, "heading"))
        col.append(label(sub, "sub", wrap=True))
        row.append(col)
        self.root.append(row)

    def need_password(self, why, then):
        if self.password is not None:
            then()
            return

        def ok(pw):
            self.password = pw
            then()
        PasswordBox(self, why, ok).present()

    def log_area(self, height=190):
        """A details area (collapsed) with the raw output, a progress bar, and a one-line status."""
        self.status = label("", "status", wrap=True)
        self.progress = Gtk.ProgressBar()
        self.progress.set_visible(False)
        self.view = mk(Gtk.TextView(editable=False, cursor_visible=False, monospace=True), "log")
        self.view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.view.set_left_margin(10)
        self.view.set_right_margin(10)
        sw = mk(Gtk.ScrolledWindow(), "logbox")
        sw.set_min_content_height(height)
        sw.set_child(self.view)
        self.details = Gtk.Expander(label="Show details")
        self.details.set_child(sw)
        self.details.set_visible(False)
        self.pulse_id = None
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.append(self.status)
        box.append(self.progress)
        box.append(self.details)
        return box

    def log_clear(self):
        self.view.get_buffer().set_text("")

    def log_add(self, text):
        b = self.view.get_buffer()
        b.insert(b.get_end_iter(), text + "\n")
        GLib.idle_add(lambda: self.view.scroll_to_iter(b.get_end_iter(), 0, False, 0, 0) and False)

    def busy(self, on, text=None):
        self.progress.set_visible(on)
        if on:
            self.details.set_visible(True)
            if self.pulse_id is None:
                self.pulse_id = GLib.timeout_add(120, self._pulse)
        elif self.pulse_id is not None:
            GLib.source_remove(self.pulse_id)
            self.pulse_id = None
        if text is not None:
            self.status.set_text(text)

    def _pulse(self):
        self.progress.pulse()
        return True


class UpdatePage(Page):
    TITLE = "Soarix Update"

    def __init__(self, app):
        super().__init__(app)
        self.head("Soarix Update", "Keep Soarix and your apps up to date.")
        rel = os_release()
        card = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6), "card")
        card.append(label("You are running", "sub"))
        card.append(label("Soarix " + rel.get("VERSION_ID", "?"), "big"))
        card.append(label("%s edition%s" % (rel.get("VARIANT", "Soarix"), ("   build " + rel["BUILD_ID"]) if rel.get("BUILD_ID") else ""), "sub"))
        self.root.append(card)
        self.state = self.log_area()
        self.root.append(self.state)
        self.banner = mk(Gtk.Box(spacing=14), "banner")
        self.banner.append(label("An update is ready. Restart to finish installing it.", "status", wrap=True))
        self.banner.get_first_child().set_hexpand(True)
        rb = mk(Gtk.Button(label="Restart now"), "primary")
        rb.connect("clicked", lambda *_: self.admin(["systemctl", "reboot"], "Restart this computer.", None, "Restarting ..."))
        self.banner.append(rb)
        self.banner.set_visible(False)
        self.root.append(self.banner)
        actions = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        top = Gtk.Box(spacing=10)
        self.btns = []
        for text, cls, cmd, why, busy in [
            ("Check for updates", "accent", ["soarix-update", "status"], "Soarix needs your password to look for updates.", "Checking for updates ..."),
            ("Update everything", "primary", ["soarix-update", "all"], "Soarix needs your password to install updates.", "Updating Soarix and your apps ..."),
        ]:
            b = mk(Gtk.Button(label=text), cls)
            b.connect("clicked", lambda _b, c=cmd, w=why, t=busy: self.admin(c, w, self.after, t))
            top.append(b)
            self.btns.append(b)
        actions.append(top)
        bottom = Gtk.Box(spacing=10)
        for text, cmd, why, busy in [
            ("Update apps only", ["soarix-update", "apps"], "Soarix needs your password to update apps.", "Updating your apps ..."),
            ("Update Soarix only", ["soarix-update", "os"], "Soarix needs your password to install the update.", "Updating Soarix ..."),
            ("Go back to the previous version", ["soarix-update", "rollback"], "Soarix needs your password to go back to the previous version.", "Going back ..."),
        ]:
            b = Gtk.Button(label=text)
            b.connect("clicked", lambda _b, c=cmd, w=why, t=busy: self.admin(c, w, self.after, t))
            bottom.append(b)
            self.btns.append(b)
        actions.append(bottom)
        self.root.append(actions)

    def admin(self, cmd, why, done, busy_text):
        def go():
            self.log_clear()
            self.banner.set_visible(False)
            for b in self.btns:
                b.set_sensitive(False)
            self.busy(True, busy_text)
            self.seen = []

            def on_line(ln, partial):
                if not partial:
                    self.log_add(ln)
                    self.seen.append(ln)
                self.status.set_text(ln[:140])

            def on_done(rc, err):
                self.busy(False)
                for b in self.btns:
                    b.set_sensitive(True)
                if done:
                    done(rc)
            self.runner.run(cmd, on_line, on_done, admin=True, password=self.password)
        self.need_password(why, go)

    def after(self, rc):
        text = "\n".join(self.seen)
        if "after the next restart" in text or "will start at the next restart" in text or "at next restart" in text.lower():
            self.banner.set_visible(True)
            self.status.set_text("Update downloaded. Restart to finish.")
            return
        if rc != 0:
            self.status.set_text("That did not finish (see the details). Check your network and try again.")
            return
        if "up to date" in text.lower() or "already on the newest" in text.lower():
            self.status.set_text("Everything is up to date.")
        elif "update is available" in text.lower() or "Update available" in text:
            self.status.set_text("An update is available. Choose Update everything.")
        else:
            self.status.set_text("Done.")


class LicensePage(Page):
    TITLE = "Soarix License"
    SIZE = (640, 520)

    def __init__(self, app):
        super().__init__(app)
        self.head("Soarix License", "What this computer is licensed for.")
        self.card = mk(Gtk.Grid(row_spacing=10, column_spacing=24), "card")
        self.card.set_visible(False)
        self.root.append(self.card)
        self.state = self.log_area(120)
        self.root.append(self.state)
        row = Gtk.Box(spacing=10)
        self.btn_show = mk(Gtk.Button(label="Show my license"), "accent")
        self.btn_show.connect("clicked", lambda *_: self.fetch("status"))
        self.btn_check = Gtk.Button(label="Check it with the license server")
        self.btn_check.connect("clicked", lambda *_: self.fetch("check"))
        row.append(self.btn_show)
        row.append(self.btn_check)
        self.root.append(row)
        self.status.set_text("Press Show my license. Soarix will ask for your password.")

    def fetch(self, what):
        def go():
            self.log_clear()
            self.btn_show.set_sensitive(False)
            self.btn_check.set_sensitive(False)
            self.busy(True, "Reading the license ...")
            self.lines = []

            def on_line(ln, partial):
                if not partial:
                    self.lines.append(ln)
                    self.log_add(ln)

            def on_done(rc, err):
                self.busy(False)
                self.btn_show.set_sensitive(True)
                self.btn_check.set_sensitive(True)
                self.render(what, rc)
            self.runner.run(["soarix-license", what], on_line, on_done, admin=True, password=self.password)
        self.need_password("Soarix needs your password to read the license.", go)

    def render(self, what, rc):
        c = self.card
        c.set_visible(True)
        while c.get_first_child():
            c.remove(c.get_first_child())
        rows = []
        for ln in self.lines:
            if ":" in ln:
                k, v = ln.split(":", 1)
                rows.append((k.strip(), v.strip()))
        if what == "status" and rows:
            for i, (k, v) in enumerate(rows):
                c.attach(label(k, "label-key"), 0, i, 1, 1)
                cls = ["label-val"]
                if k.lower() == "status":
                    cls.append("good" if v.lower() == "active" else "warn")
                c.attach(label(v, *cls), 1, i, 1, 1)
            self.status.set_text("")
        else:
            msg = " ".join(self.lines) or "No answer from the license tool."
            c.attach(label(msg, "label-val", wrap=True), 0, 0, 1, 1)
            self.status.set_text("")


class EssentialsPage(Page):
    TITLE = "Soarix Essentials"
    SIZE = (760, 760)

    def __init__(self, app):
        super().__init__(app)
        self.head("Soarix Essentials", "Recommended everyday apps from Flathub. About 2 GB in total.")
        self.checks = {}
        sw = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        installed = self.installed_apps()
        for aid, name, desc, _ in APPS:
            row = mk(Gtk.Box(spacing=14), "approw")
            cb = Gtk.CheckButton()
            cb.set_active(aid not in installed)
            cb.set_sensitive(aid not in installed)
            self.checks[aid] = cb
            row.append(cb)
            txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            txt.append(label(name, "label-val"))
            txt.append(label(desc, "sub", wrap=True))
            row.append(txt)
            if aid in installed:
                row.append(mk(Gtk.Label(label="Installed", valign=Gtk.Align.CENTER), "tag"))
            col.append(row)
        sw.set_child(col)
        self.root.append(sw)
        self.state = self.log_area(110)
        self.root.append(self.state)
        row = Gtk.Box(spacing=10)
        self.go_btn = mk(Gtk.Button(label="Install the selected apps"), "primary")
        self.go_btn.connect("clicked", lambda *_: self.install())
        self.all_btn = Gtk.Button(label="Select all")
        self.all_btn.connect("clicked", lambda *_: [cb.set_active(True) for a, cb in self.checks.items() if cb.get_sensitive()])
        row.append(self.go_btn)
        row.append(self.all_btn)
        self.root.append(row)
        if not any(cb.get_sensitive() for cb in self.checks.values()):
            self.status.set_text("All the recommended apps are already installed.")
            self.go_btn.set_sensitive(False)

    def installed_apps(self):
        try:
            r = subprocess.run(["flatpak", "list", "--app", "--columns=application"], capture_output=True, text=True, timeout=30)
            return set(r.stdout.split())
        except (OSError, subprocess.TimeoutExpired):
            return set()

    def install(self):
        ids = [a for a, cb in self.checks.items() if cb.get_active() and cb.get_sensitive()]
        if not ids:
            self.status.set_text("Nothing selected.")
            return

        def go():
            self.log_clear()
            self.go_btn.set_sensitive(False)
            self.busy(True, "Installing %d app%s. This can take a while ..." % (len(ids), "" if len(ids) == 1 else "s"))

            def on_line(ln, partial):
                if not partial:
                    self.log_add(ln)
                self.status.set_text(ln[:140])

            def on_done(rc, err):
                self.busy(False)
                self.go_btn.set_sensitive(True)
                if rc == 0:
                    self.status.set_text("Done. The new apps are in the Apps drawer.")
                    for a in ids:
                        self.checks[a].set_sensitive(False)
                        self.checks[a].set_active(False)
                    self.go_btn.set_sensitive(False)
                else:
                    self.status.set_text("Something did not install. Check your network and try again.")
            self.runner.run(["flatpak", "install", "-y", "--noninteractive", "flathub"] + ids, on_line, on_done,
                            admin=True, password=self.password)
        self.need_password("Soarix needs your password to install apps.", go)


DT_CONF = os.path.expanduser("~/.config/soarix/datetime.json")


def dt_load():
    try:
        return json.load(open(DT_CONF))
    except (OSError, ValueError):
        return {}


def dt_save(d):
    os.makedirs(os.path.dirname(DT_CONF), exist_ok=True)
    with open(DT_CONF, "w") as f:
        json.dump(d, f)


def timedatectl(prop):
    try:
        return subprocess.run(["timedatectl", "show", "-p", prop, "--value"], capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


class DateTimePage(Page):
    TITLE = "Date & Time"
    SIZE = (700, 720)

    def __init__(self, app):
        super().__init__(app)
        self.head("Date & Time", "Time zone, clock format and automatic time.")
        self.quiet = True
        card = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4), "card")
        self.clock = label("", "big")
        self.day = label("", "sub")
        card.append(self.clock)
        card.append(self.day)
        self.root.append(card)

        grid = mk(Gtk.Grid(row_spacing=16, column_spacing=20), "card")
        zones = subprocess.run(["timedatectl", "list-timezones"], capture_output=True, text=True).stdout.split()
        self.zones = zones or ["UTC"]
        self.dd = Gtk.DropDown.new_from_strings(self.zones)
        self.dd.set_enable_search(True)
        self.dd.set_expression(Gtk.PropertyExpression.new(Gtk.StringObject, None, "string"))
        self.dd.set_hexpand(True)
        cur = timedatectl("Timezone")
        if cur in self.zones:
            self.dd.set_selected(self.zones.index(cur))
        self.zone_btn = mk(Gtk.Button(label="Set time zone"), "primary")
        self.zone_btn.connect("clicked", lambda *_: self.set_zone())
        grid.attach(label("Time zone", "label-val"), 0, 0, 1, 1)
        grid.attach(self.dd, 1, 0, 1, 1)
        grid.attach(self.zone_btn, 2, 0, 1, 1)

        self.sw24 = Gtk.Switch(valign=Gtk.Align.CENTER, halign=Gtk.Align.END)
        self.sw24.set_active(bool(dt_load().get("clock24", False)))
        self.sw24.connect("notify::active", lambda *_: self.on_24())
        grid.attach(label("24-hour (military) time", "label-val"), 0, 1, 2, 1)
        grid.attach(self.sw24, 2, 1, 1, 1)

        self.swbar = Gtk.Switch(valign=Gtk.Align.CENTER, halign=Gtk.Align.END)
        self.swbar.set_active(bool(dt_load().get("show_clock", True)))
        self.swbar.connect("notify::active", lambda *_: self.on_bar())
        grid.attach(label("Show the date and time in the top bar", "label-val"), 0, 2, 2, 1)
        grid.attach(self.swbar, 2, 2, 1, 1)

        self.swntp = Gtk.Switch(valign=Gtk.Align.CENTER, halign=Gtk.Align.END)
        self.swntp.set_active(timedatectl("NTP") == "yes")
        self.swntp.connect("notify::active", lambda *_: self.on_ntp())
        grid.attach(label("Set the time automatically from the internet", "label-val"), 0, 3, 2, 1)
        grid.attach(self.swntp, 2, 3, 1, 1)

        self.manual = Gtk.Box(spacing=10)
        self.date_in = Gtk.Entry(placeholder_text="YYYY-MM-DD", max_width_chars=12)
        self.time_in = Gtk.Entry(placeholder_text="HH:MM  (24-hour)", max_width_chars=12)
        now = time.localtime()
        self.date_in.set_text(time.strftime("%Y-%m-%d", now))
        self.time_in.set_text(time.strftime("%H:%M", now))
        self.set_btn = Gtk.Button(label="Set date and time")
        self.set_btn.connect("clicked", lambda *_: self.set_manual())
        self.manual.append(self.date_in)
        self.manual.append(self.time_in)
        self.manual.append(self.set_btn)
        grid.attach(label("Date and time", "label-val"), 0, 4, 1, 1)
        grid.attach(self.manual, 1, 4, 2, 1)
        self.manual_row = [grid.get_child_at(0, 4), self.manual]
        self.root.append(grid)

        self.state = self.log_area(110)
        self.root.append(self.state)
        self.quiet = False
        self.show_manual()
        GLib.timeout_add_seconds(1, self.tick)
        self.tick()

    def fmt(self):
        return "%H:%M:%S" if self.sw24.get_active() else "%-I:%M:%S %p"

    def tick(self):
        t = time.localtime()
        self.clock.set_text(time.strftime(self.fmt(), t))
        self.day.set_text(time.strftime("%A, %B %-d, %Y", t) + "   " + (time.tzname[t.tm_isdst > 0] if time.tzname else ""))
        return True

    def show_manual(self):
        for w in self.manual_row:
            w.set_visible(not self.swntp.get_active())

    def on_24(self):
        if self.quiet:
            return
        d = dt_load()
        d["clock24"] = self.sw24.get_active()
        dt_save(d)
        subprocess.Popen(["soarix-appearance", "restart-bar"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        self.tick()
        self.status.set_text("Clock format saved. The top bar and the lock screen use it.")

    def on_bar(self):
        if self.quiet:
            return
        d = dt_load()
        d["show_clock"] = self.swbar.get_active()
        dt_save(d)
        subprocess.Popen(["soarix-appearance", "restart-bar"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        self.status.set_text("The date and time are %s in the top bar." % ("shown" if self.swbar.get_active() else "hidden"))

    def run_admin(self, cmd, why, busy_text, done_text, after=None):
        def go():
            self.log_clear()
            self.busy(True, busy_text)

            def on_line(ln, partial):
                if not partial:
                    self.log_add(ln)

            def on_done(rc, err):
                self.busy(False)
                time.tzset()
                self.tick()
                self.status.set_text(done_text if rc == 0 else "That did not work (see the details).")
                if after:
                    after(rc)
            self.runner.run(cmd, on_line, on_done, admin=True, password=self.password)
        self.need_password(why, go)

    def set_zone(self):
        z = self.zones[self.dd.get_selected()]
        self.run_admin(["timedatectl", "set-timezone", z], "Soarix needs your password to change the time zone.",
                       "Changing the time zone ...", "Time zone set to %s." % z)

    def on_ntp(self):
        self.show_manual()
        if self.quiet:
            return
        want = self.swntp.get_active()

        def after(rc):
            if rc != 0:
                self.quiet = True
                self.swntp.set_active(timedatectl("NTP") == "yes")
                self.quiet = False
                self.show_manual()
        self.run_admin(["timedatectl", "set-ntp", "true" if want else "false"], "Soarix needs your password to change the time setting.",
                       "Saving ...", "The time is now set automatically." if want else "Automatic time is off. Set the date and time below.", after)

    def set_manual(self):
        try:
            import datetime
            when = datetime.datetime.strptime(self.date_in.get_text().strip() + " " + self.time_in.get_text().strip(), "%Y-%m-%d %H:%M")
        except ValueError:
            self.status.set_text("Type the date like 2026-11-22 and the time like 14:30.")
            return
        self.run_admin(["timedatectl", "set-time", when.strftime("%Y-%m-%d %H:%M:00")], "Soarix needs your password to set the date and time.",
                       "Setting the date and time ...", "Date and time set.")


class SysInfoPage(Page):
    TITLE = "System Information"
    SIZE = (780, 880)

    def __init__(self, app):
        super().__init__(app)
        self.head("System Information", "About this computer and the edition of Soarix it runs.")
        info = self.load_info()
        top = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4), "card")
        top.append(label("You are running", "sub"))
        top.append(label("Soarix " + info.get("soarix", "?"), "big"))
        top.append(label("%s edition%s" % (info.get("edition", ""), ("   build " + info["build"]) if info.get("build") else ""), "sub"))
        self.root.append(top)

        scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        grid = mk(Gtk.Grid(row_spacing=10, column_spacing=24), "card")
        row = 0
        for lab, key in [("Computer name", "computer_name"), ("Computer", "machine"), ("Processor", "processor"), ("Memory", "memory"),
                         ("Storage", "storage"), ("Graphics", "graphics"), ("Network", "network"), ("Kernel", "kernel"), ("Running for", "uptime")]:
            v = info.get(key)
            if isinstance(v, list):
                v = ", ".join(v) or "not connected"
            if not v:
                continue
            grid.attach(label(lab, "label-key"), 0, row, 1, 1)
            val = label(v, "label-val", wrap=True)
            val.set_hexpand(True)
            val.set_selectable(True)
            grid.attach(val, 1, row, 1, 1)
            row += 1
        col.append(grid)

        ed = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "card")
        ed.append(label("Edition", "heading"))
        ed.append(label("Switch between the command line, the desktop and the server edition. Your files and settings stay. "
                        "The change starts after a restart. Your license must include the edition.", "sub", wrap=True))
        btns = Gtk.Box(spacing=10)
        self.ed_btns = []
        self.ed_list = (("core", "Command line"), ("desktop", "Desktop"), ("server", "Server"))
        for key, name in self.ed_list:
            b = Gtk.Button(label=name)
            b.connect("clicked", lambda _b, k=key, n=name: self.switch(k, n))
            btns.append(b)
            self.ed_btns.append(b)
        ed.append(btns)
        col.append(ed)

        if os.path.exists("/usr/bin/niri"):
            st = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "card")
            st.append(label("How Soarix starts", "heading"))
            st.append(label("Choose what you see after a restart: the command line (the web console at port 9090 is always there) or the "
                            "graphical desktop. You can switch back at any time.", "sub", wrap=True))
            row = Gtk.Box(spacing=10)
            self.start_btns = []
            for key, name in (("off", "Command line"), ("on", "Desktop")):
                b = Gtk.Button(label=name)
                b.connect("clicked", lambda _b, k=key, n=name: self.start_mode(k, n))
                row.append(b)
                self.start_btns.append((b, key))
            st.append(row)
            self.start_note = label("", "sub", wrap=True)
            st.append(self.start_note)
            col.append(st)
            self.show_start_mode()

        up = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "card")
        up.append(label("Upgrade your license", "heading"))
        up.append(label("Have a new key, for example one that adds the server edition? Type it here.", "sub", wrap=True))
        krow = Gtk.Box(spacing=10)
        self.key = Gtk.Entry(placeholder_text="SOAR-XXXX-XXXX-XXXX-XXXX", hexpand=True)
        self.key_btn = mk(Gtk.Button(label="Use this key"), "accent")
        self.key_btn.connect("clicked", lambda *_: self.upgrade())
        krow.append(self.key)
        krow.append(self.key_btn)
        up.append(krow)
        col.append(up)
        scroll.set_child(col)
        self.root.append(scroll)

        self.state = self.log_area(120)
        self.root.append(self.state)
        self.sync_buttons(info)
        self.banner = mk(Gtk.Box(spacing=14), "banner")
        msg = label("The new edition is ready. Restart to start it.", "status", wrap=True)
        msg.set_hexpand(True)
        self.banner.append(msg)
        rb = mk(Gtk.Button(label="Restart now"), "primary")
        rb.connect("clicked", lambda *_: self.admin(["systemctl", "reboot"], "Soarix needs your password to restart.", "Restarting ...", None))
        self.banner.append(rb)
        self.banner.set_visible(False)
        self.root.append(self.banner)

    def show_start_mode(self):
        cur = subprocess.run(["systemctl", "get-default"], capture_output=True, text=True).stdout.strip()
        desktop = cur == "graphical.target"
        for b, key in self.start_btns:
            here = (key == "on") == desktop
            b.set_sensitive(not here)
            b.set_label(("Desktop" if key == "on" else "Command line") + ("   (now)" if here else ""))

    def start_mode(self, key, name):
        def after(rc):
            self.show_start_mode()
            self.status.set_text(("%s will start at the next restart." % name) if rc == 0 else "That did not work (see the details).")
        self.admin(["soarix-desktop", key, "--next-boot"], "Soarix needs your password to change how it starts.",
                   "Saving ...", after)

    def sync_buttons(self, info=None):
        """Edition buttons: the current one and the ones the license does not include are not clickable."""
        info = info or self.load_info()
        lic = info.get("licensed")  # None = not known yet, so the command itself decides
        for b, (key, name) in zip(self.ed_btns, self.ed_list):
            here = info.get("edition") == name
            blocked = lic is not None and key not in lic
            b.set_sensitive(not here and not blocked)
            b.set_label(name + ("   (this one)" if here else ("   (needs an upgraded key)" if blocked else "")))

    def load_info(self):
        try:
            return json.loads(subprocess.run(["soarix-info", "--json"], capture_output=True, text=True, timeout=20).stdout)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            return {}

    def admin(self, cmd, why, busy_text, done):
        def go():
            self.log_clear()
            self.banner.set_visible(False)
            self.key_btn.set_sensitive(False)
            for b in self.ed_btns:
                b.set_sensitive(False)
            self.busy(True, busy_text)
            self.seen = []

            def on_line(ln, partial):
                if not partial:
                    self.log_add(ln)
                    self.seen.append(ln)
                self.status.set_text(ln[:140])

            def on_done(rc, err):
                self.busy(False)
                self.key_btn.set_sensitive(True)
                self.sync_buttons()
                if done:
                    done(rc)
            self.runner.run(cmd, on_line, on_done, admin=True, password=self.password)
        self.need_password(why, go)

    def switch(self, key, name):
        def after(rc):
            text = " ".join(self.seen)
            if "starts at the next restart" in text:
                self.banner.set_visible(True)
                self.status.set_text("The %s edition is downloaded. Restart to start it." % name)
            elif rc != 0:
                self.status.set_text(self.seen[-1] if self.seen else "That did not finish.")
        self.admin(["soarix-edition", "switch", key], "Soarix needs your password to switch to the %s edition." % name,
                   "Switching to the %s edition ..." % name, after)

    def upgrade(self):
        k = self.key.get_text().strip()
        if not k:
            self.status.set_text("Type your new license key first.")
            return

        def after(rc):
            self.status.set_text("License updated. See the details for what it now includes." if rc == 0
                                 else (self.seen[-1] if self.seen else "That key was not accepted."))
        self.admin(["soarix-edition", "upgrade", k], "Soarix needs your password to change the license.", "Checking the key ...", after)


class ServicesPage(Page):
    TITLE = "Server Services"
    SIZE = (800, 820)

    def __init__(self, app):
        super().__init__(app)
        self.head("Server Services", "Turn the hosting pieces on and off. Nothing runs until you turn it on.")
        self.quiet = True
        self.rows = {}
        top = Gtk.Box(spacing=12)
        note = label("Manage opens a window for each service. For sites, mail domains, DNS zones and databases, use the NovaCPX add-on (coming) or the web console.", "sub", wrap=True)
        note.set_hexpand(True)
        top.append(note)
        wc = Gtk.Button(label="Open the web console")
        wc.connect("clicked", lambda *_: subprocess.Popen(["xdg-open", "https://localhost:9090"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
        top.append(wc)
        self.root.append(top)
        scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for g in self.groups():
            row = mk(Gtk.Box(spacing=14), "approw")
            sw = Gtk.Switch(valign=Gtk.Align.CENTER)
            sw.set_active(bool(g["on"]))
            sw.connect("notify::active", lambda _s, _p, grp=g: self.toggled(grp))
            row.append(sw)
            txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            txt.append(label(g["description"], "label-val", wrap=True))
            ports = ("Opens: " + ", ".join(g["firewall"])) if g["firewall"] else "No ports opened"
            txt.append(label("%s   %s" % (g["group"], ports), "sub", wrap=True))
            row.append(txt)
            state = label("", "tag")
            row.append(state)
            mb = Gtk.Button(label="Manage")
            mb.connect("clicked", lambda _b, grp=g: GroupWindow(self, grp).present())
            row.append(mb)
            col.append(row)
            self.rows[g["group"]] = (sw, state)
        scroll.set_child(col)
        self.root.append(scroll)
        self.state = self.log_area(110)
        self.root.append(self.state)
        self.refresh()
        self.quiet = False

    def groups(self):
        try:
            return json.loads(subprocess.run(["soarix-server", "list", "--json"], capture_output=True, text=True, timeout=60).stdout)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            return []

    def refresh(self):
        self.quiet = True
        for g in self.groups():
            sw, st = self.rows[g["group"]]
            sw.set_active(bool(g["on"]))
            running = [u["unit"] for u in g["units"] if u["state"] == "active"]
            st.set_text("Running" if running else ("On, not running" if g["on"] else "Off"))
            if running or g["on"]:
                st.remove_css_class("tag-off")
            else:
                st.add_css_class("tag-off")
        self.quiet = False

    def toggled(self, g):
        if self.quiet:
            return
        sw, _ = self.rows[g["group"]]
        want = sw.get_active()
        name = g["group"]
        if want:
            cmd = "soarix-server enable %s" % name
            if g["firewall"]:
                cmd += " && soarix-server firewall %s" % name
            busy = "Turning on %s ..." % name
            done = "%s is on%s." % (name, (" and its ports (%s) are open" % ", ".join(g["firewall"])) if g["firewall"] else "")
        else:
            cmd, busy, done = "soarix-server disable %s" % name, "Turning off %s ..." % name, "%s is off." % name

        def go():
            self.log_clear()
            self.busy(True, busy)

            def on_line(ln, partial):
                if not partial:
                    self.log_add(ln)

            def on_done(rc, err):
                self.busy(False)
                self.refresh()
                self.status.set_text(done if rc == 0 else "That did not finish (see the details).")
            self.runner.run(["sh", "-c", cmd], on_line, on_done, admin=True, password=self.password)

        def cancelled_check():
            go()
        if self.password is None:
            self.need_password("Soarix needs your password to change a server service.", cancelled_check)
        else:
            go()


CHECKS = {
    "web": "nginx -t && php-fpm -t",
    "apache": "httpd -t && php-fpm -t",
    "dns": "unbound-checkconf",
    "ns": "named-checkconf",
    "mail": "postfix check",
    "proxy": "haproxy -c -f /etc/haproxy/haproxy.cfg",
    "security": "fail2ban-client -t",
}


class GroupWindow(Gtk.Window):
    """Start, stop, restart, check the settings and read the recent log of one server service group."""

    def __init__(self, page, g):
        super().__init__(transient_for=page, title=g["description"])
        mk(self, "soarix-dialog")
        self.page, self.g = page, g
        self.units = ["%s.service" % u["unit"] for u in g["units"]]
        self.set_default_size(720, 580)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        for m in ("top", "bottom", "start", "end"):
            getattr(box, "set_margin_" + m)(22)
        box.append(label(g["description"], "heading", wrap=True))
        box.append(label("Services: " + ", ".join(u["unit"] for u in g["units"]) +
                         (("      Ports: " + ", ".join(g["firewall"])) if g["firewall"] else ""), "sub", wrap=True))
        row = Gtk.Box(spacing=10)
        for text, verb in (("Start", "start"), ("Stop", "stop"), ("Restart", "restart")):
            b = mk(Gtk.Button(label=text), "primary") if verb == "restart" else Gtk.Button(label=text)
            b.connect("clicked", lambda _b, v=verb: self.run_cmd("systemctl %s %s" % (v, " ".join(self.units)), "%s ..." % text))
            row.append(b)
        if g["group"] in CHECKS:
            cb = mk(Gtk.Button(label="Check the settings"), "accent")
            cb.connect("clicked", lambda *_: self.run_cmd(CHECKS[g["group"]], "Checking the settings ..."))
            row.append(cb)
        lb = Gtk.Button(label="Show the recent log")
        lb.connect("clicked", lambda *_: self.run_cmd("journalctl -n 80 --no-pager " + " ".join("-u " + u for u in self.units), "Reading the log ..."))
        row.append(lb)
        box.append(row)
        self.status = label("", "status", wrap=True)
        box.append(self.status)
        self.progress = Gtk.ProgressBar()
        self.progress.set_visible(False)
        box.append(self.progress)
        self.view = mk(Gtk.TextView(editable=False, cursor_visible=False, monospace=True), "log")
        self.view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.view.set_left_margin(10)
        self.view.set_right_margin(10)
        sw = mk(Gtk.ScrolledWindow(vexpand=True), "logbox")
        sw.set_child(self.view)
        box.append(sw)
        close = Gtk.Button(label="Close", halign=Gtk.Align.END)
        close.connect("clicked", lambda *_: self.close())
        box.append(close)
        self.set_child(box)
        self.pulse_id = None

    def say(self, text):
        b = self.view.get_buffer()
        b.insert(b.get_end_iter(), text + "\n")

    def run_cmd(self, cmd, busy_text):
        def go():
            self.view.get_buffer().set_text("")
            self.status.set_text(busy_text)
            self.progress.set_visible(True)
            self.pulse_id = GLib.timeout_add(120, lambda: (self.progress.pulse(), True)[1])

            def on_line(ln, partial):
                if not partial:
                    self.say(ln)

            def on_done(rc, err):
                if self.pulse_id is not None:
                    GLib.source_remove(self.pulse_id)
                    self.pulse_id = None
                self.progress.set_visible(False)
                self.status.set_text("Done." if rc == 0 else "That reported a problem (see below).")
                self.page.refresh()
            self.page.runner.run(["sh", "-c", cmd], on_line, on_done, admin=True, password=self.page.password)
        self.page.need_password("Soarix needs your password to manage this service.", go)


PAGES = {"update": UpdatePage, "license": LicensePage, "essentials": EssentialsPage, "datetime": DateTimePage,
         "sysinfo": SysInfoPage, "services": ServicesPage}


def main():
    page = sys.argv[1] if len(sys.argv) > 1 else ""
    if page not in PAGES:
        print(__doc__)
        return 2
    app = Gtk.Application(application_id="com.soarix.%s" % page, flags=Gio.ApplicationFlags.NON_UNIQUE)

    def activate(a):
        prov = Gtk.CssProvider()
        prov.load_from_string(css(accent()))
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)
        PAGES[page](a).present()
    app.connect("activate", activate)
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
