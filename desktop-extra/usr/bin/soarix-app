#!/usr/bin/python3
"""soarix-app - the Soarix Update, License and Essentials windows.

  soarix-app update       look for updates, update Soarix and apps, go back to the previous version
  soarix-app license      what this computer is licensed for
  soarix-app essentials   install the recommended everyday apps
  soarix-app datetime     time zone, 12 or 24 hour clock, automatic time
  soarix-app sysinfo      about this computer, switch edition, upgrade the license
  soarix-app services     (Server edition) turn the hosting services on and off
  soarix-app appearance   wallpaper, theme, accent color
  soarix-app display      screen size, text size, lock screen, screen saver
  soarix-app network      connections, Wi-Fi, network tools
  soarix-app printers     add printers, default printer, test page
  soarix-app devices      find the devices on your network
  soarix-app users        add people, passwords, administrators
  soarix-app addons       add and remove add-ons (software that is not public)

Graphical windows in the Soarix style. Anything that needs administrator rights asks for your
password in a Soarix box (it is used only for that task and is never stored).
"""
import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, GLib, Gio, Gtk, Pango  # noqa: E402

APPEARANCE = os.path.expanduser("~/.config/soarix/appearance.json")
ACCENTS = {"teal": "4fb3c8", "blue": "5b8def", "green": "5fc27a", "yellow": "e0c050", "orange": "e08a3c",
           "red": "e0605a", "pink": "e07aa8", "purple": "a07be0", "slate": "8ea2c4"}
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\x1b\][^\x07]*\x07")

APPS = [
    ("org.libreoffice.LibreOffice", "LibreOffice", "Word processor, spreadsheets and presentations. Opens Microsoft Office files.", "libreoffice-startcenter"),
    ("org.mozilla.Thunderbird", "Thunderbird", "Email, calendar and contacts.", "thunderbird"),
    ("org.videolan.VLC", "VLC", "Plays almost any audio or video file.", "vlc"),
    ("org.gimp.GIMP", "GIMP", "Photo editing and drawing.", "gimp"),
    ("com.bitwarden.desktop", "Bitwarden", "Password manager.", "bitwarden"),
    ("com.usebottles.bottles", "Bottles", "Run Windows programs on Soarix.", "com.usebottles.bottles"),
    ("com.github.tchx84.Flatseal", "Flatseal", "See and change what each app is allowed to do.", "com.github.tchx84.Flatseal"),
]


def accent():
    try:
        n = json.load(open(APPEARANCE)).get("accent", "teal")
    except (OSError, ValueError):
        n = "teal"
    return ACCENTS.get(n, ACCENTS["teal"])


