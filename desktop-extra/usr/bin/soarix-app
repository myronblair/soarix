def os_release():
    d = {}
    try:
        for ln in open("/usr/lib/os-release"):
            if "=" in ln:
                k, v = ln.rstrip().split("=", 1)
                d[k] = v.strip('"')
    except OSError:
        pass
    return d


def mk(widget, *classes):
    for c in classes:
        widget.add_css_class(c)
    return widget


def label(text, *classes, xalign=0.0, wrap=False):
    lb = Gtk.Label(label=text, xalign=xalign)
    lb.set_wrap(wrap)
    if wrap:
        lb.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
    return mk(lb, *classes)


class Runner:
    """Runs a command in the background (with administrator rights when asked) and streams its output."""

    def __init__(self, win):
        self.win = win

    def run(self, cmd, on_line, on_done, admin=False, password=None, extra_stdin=None):
        def work():
            full = (["sudo", "-S", "-p", ""] + (["-k"] if (password and extra_stdin) else []) + cmd) if admin else cmd
            if admin and password == "":
                full = ["sudo", "-n"] + cmd  # the system remembers the password: never wait for one
            try:
                p = subprocess.Popen(full, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                     env=dict(os.environ, LC_ALL="C.UTF-8", TERM="dumb"))
            except OSError as e:
                GLib.idle_add(on_done, 127, str(e))
                return
            try:
                if admin and password:
                    p.stdin.write((password + "\n").encode())
                if extra_stdin:
                    p.stdin.write(extra_stdin.encode())
                p.stdin.close()
            except OSError:
                pass
            buf = ""
            expired = False
            while True:
                chunk = os.read(p.stdout.fileno(), 4096)
                if not chunk:
                    break
                text = ANSI.sub("", chunk.decode("utf-8", "replace"))
                if "password is required" in text or "incorrect password" in text:
                    expired = True
                buf += text
                parts = re.split(r"[\r\n]", buf)
                buf = parts.pop()
                for ln in parts:
                    if ln.strip():
                        GLib.idle_add(on_line, ln.rstrip(), False)
                if buf.strip():
                    GLib.idle_add(on_line, buf.strip(), True)
            rc = p.wait()
            if expired and admin:
                GLib.idle_add(setattr, self.win, "password", None)
            GLib.idle_add(on_done, rc, "")
        threading.Thread(target=work, daemon=True).start()


class PasswordBox(Gtk.Window):
    """A Soarix-style box that asks for the password of the signed-in user."""

    def __init__(self, parent, why, on_ok):
        super().__init__(transient_for=parent, modal=True, title="Administrator password")
        mk(self, "soarix-dialog")
        self.on_ok = on_ok
        self.set_default_size(420, -1)
        self.set_resizable(False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        for m in ("top", "bottom", "start", "end"):
            getattr(box, "set_margin_" + m)(24)
        box.append(label("Password needed", "heading"))
        box.append(label(why, "sub", wrap=True))
        self.entry = Gtk.PasswordEntry(show_peek_icon=True)
        self.entry.connect("activate", self.go)
        box.append(self.entry)
        self.msg = label("", "bad")
        box.append(self.msg)
        row = Gtk.Box(spacing=10, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda *_: self.close())
        self.ok = mk(Gtk.Button(label="Continue"), "primary")
        self.ok.connect("clicked", self.go)
        row.append(cancel)
        row.append(self.ok)
        box.append(row)
        self.set_child(box)
        self.entry.grab_focus()

    def go(self, *_):
        pw = self.entry.get_text()
        if not pw:
            return
        self.ok.set_sensitive(False)
        self.msg.set_text("Checking ...")

        def check():
            try:
                p = subprocess.run(["sudo", "-S", "-p", "", "-v"], input=(pw + "\n").encode(), capture_output=True, timeout=30)
                good = p.returncode == 0
            except (OSError, subprocess.TimeoutExpired):
                good = False
            GLib.idle_add(self.done, good, pw)
        threading.Thread(target=check, daemon=True).start()

    def done(self, good, pw):
        if good:
            self.close()
            self.on_ok(pw)
        else:
            self.ok.set_sensitive(True)
            self.msg.set_text("That password did not work. Try again.")
            self.entry.set_text("")
            self.entry.grab_focus()


class Page(Gtk.ApplicationWindow):
    TITLE = "Soarix"
    SIZE = (780, 640)

    def __init__(self, app):
        super().__init__(application=app, title=self.TITLE)
        mk(self, "soarix")
        self.set_default_size(*self.SIZE)
        self.password = None
        self.runner = Runner(self)
        hb = Gtk.HeaderBar()
        self.set_titlebar(hb)
        self.root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        for m in ("top", "bottom", "start", "end"):
            getattr(self.root, "set_margin_" + m)(22)
        self.set_child(self.root)
        self.connect("close-request", self.on_close)

    def on_close(self, *_):
        self.password = None
        return False

    def head(self, title, sub):
        row = Gtk.Box(spacing=16)
        img = Gtk.Image.new_from_icon_name("soarix")
        img.set_pixel_size(56)
        row.append(img)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, valign=Gtk.Align.CENTER)
        col.append(label(title, "heading"))
        col.append(label(sub, "sub", wrap=True))
        row.append(col)
        self.root.append(row)

    def need_password(self, why, then):
        if self.password is not None:
            then()
            return
        try:  # the system may already remember the password (see Administrator password in System Information)
            if subprocess.run(["sudo", "-n", "-v"], capture_output=True, timeout=10).returncode == 0:
                self.password = ""
                then()
                return
        except (OSError, subprocess.TimeoutExpired):
            pass

        def ok(pw):
            self.password = pw
            then()
        PasswordBox(self, why, ok).present()

    def log_area(self, height=190):
        """A details area (collapsed) with the raw output, a progress bar, and a one-line status."""
        self.status = label("", "status", wrap=True)
        self.progress = Gtk.ProgressBar()
        self.progress.set_visible(False)
        self.view = mk(Gtk.TextView(editable=False, cursor_visible=False, monospace=True), "log")
        self.view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.view.set_left_margin(10)
        self.view.set_right_margin(10)
        sw = mk(Gtk.ScrolledWindow(), "logbox")
        sw.set_min_content_height(height)
        sw.set_child(self.view)
        self.details = Gtk.Expander(label="Show details")
        self.details.set_child(sw)
        self.details.set_visible(False)
        self.pulse_id = None
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.append(self.status)
        box.append(self.progress)
        box.append(self.details)
        return box

    def log_clear(self):
        self.view.get_buffer().set_text("")

    def log_add(self, text):
        b = self.view.get_buffer()
        b.insert(b.get_end_iter(), text + "\n")
        GLib.idle_add(lambda: self.view.scroll_to_iter(b.get_end_iter(), 0, False, 0, 0) and False)

    def busy(self, on, text=None):
        self.progress.set_visible(on)
        if on:
            self.details.set_visible(True)
            if self.pulse_id is None:
                self.pulse_id = GLib.timeout_add(120, self._pulse)
        elif self.pulse_id is not None:
            GLib.source_remove(self.pulse_id)
            self.pulse_id = None
        if text is not None:
            self.status.set_text(text)

    def _pulse(self):
        self.progress.pulse()
        return True


class UpdatePage(Page):
    TITLE = "Soarix Update"

    def __init__(self, app):
        super().__init__(app)
        self.head("Soarix Update", "Keep Soarix and your apps up to date.")
        rel = os_release()
        card = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6), "card")
        card.append(label("You are running", "sub"))
        card.append(label("Soarix " + rel.get("VERSION_ID", "?"), "big"))
        card.append(label("%s edition%s" % (rel.get("VARIANT", "Soarix"), ("   build " + rel["BUILD_ID"]) if rel.get("BUILD_ID") else ""), "sub"))
        self.root.append(card)
        self.state = self.log_area()
        self.root.append(self.state)
        self.banner = mk(Gtk.Box(spacing=14), "banner")
        self.banner.append(label("An update is ready. Restart to finish installing it.", "status", wrap=True))
        self.banner.get_first_child().set_hexpand(True)
        rb = mk(Gtk.Button(label="Restart now"), "primary")
        rb.connect("clicked", lambda *_: self.admin(["systemctl", "reboot"], "Restart this computer.", None, "Restarting ..."))
        self.banner.append(rb)
        self.banner.set_visible(False)
        self.root.append(self.banner)
        actions = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        top = Gtk.Box(spacing=10)
        self.btns = []
        for text, cls, cmd, why, busy in [
            ("Check for updates", "accent", ["soarix-update", "status"], "Soarix needs your password to look for updates.", "Checking for updates ..."),
            ("Update everything", "primary", ["soarix-update", "all"], "Soarix needs your password to install updates.", "Updating Soarix and your apps ..."),
        ]:
            b = mk(Gtk.Button(label=text), cls)
            b.connect("clicked", lambda _b, c=cmd, w=why, t=busy: self.admin(c, w, self.after, t))
            top.append(b)
            self.btns.append(b)
        actions.append(top)
        bottom = Gtk.Box(spacing=10)
        for text, cmd, why, busy in [
            ("Update apps only", ["soarix-update", "apps"], "Soarix needs your password to update apps.", "Updating your apps ..."),
            ("Update Soarix only", ["soarix-update", "os"], "Soarix needs your password to install the update.", "Updating Soarix ..."),
            ("Go back to the previous version", ["soarix-update", "rollback"], "Soarix needs your password to go back to the previous version.", "Going back ..."),
        ]:
            b = Gtk.Button(label=text)
            b.connect("clicked", lambda _b, c=cmd, w=why, t=busy: self.admin(c, w, self.after, t))
            bottom.append(b)
            self.btns.append(b)
        actions.append(bottom)
        self.root.append(actions)

    def admin(self, cmd, why, done, busy_text):
        def go():
            self.log_clear()
            self.banner.set_visible(False)
            for b in self.btns:
                b.set_sensitive(False)
            self.busy(True, busy_text)
            self.seen = []

            def on_line(ln, partial):
                if not partial:
                    self.log_add(ln)
                    self.seen.append(ln)
                self.status.set_text(ln[:140])

            def on_done(rc, err):
                self.busy(False)
                for b in self.btns:
                    b.set_sensitive(True)
                if done:
                    done(rc)
            self.runner.run(cmd, on_line, on_done, admin=True, password=self.password)
        self.need_password(why, go)

    def after(self, rc):
        text = "\n".join(self.seen)
        if "after the next restart" in text or "will start at the next restart" in text or "at next restart" in text.lower():
            self.banner.set_visible(True)
            self.status.set_text("Update downloaded. Restart to finish.")
            return
        if rc != 0:
            self.status.set_text("That did not finish (see the details). Check your network and try again.")
            return
        if "up to date" in text.lower() or "already on the newest" in text.lower():
            self.status.set_text("Everything is up to date.")
        elif "update is available" in text.lower() or "Update available" in text:
            self.status.set_text("An update is available. Choose Update everything.")
        else:
            self.status.set_text("Done.")


class LicensePage(Page):
    TITLE = "Soarix License"
    SIZE = (640, 520)

    def __init__(self, app):
        super().__init__(app)
        self.head("Soarix License", "What this computer is licensed for.")
        self.card = mk(Gtk.Grid(row_spacing=10, column_spacing=24), "card")
        self.card.set_visible(False)
        self.root.append(self.card)
        self.state = self.log_area(120)
        self.root.append(self.state)
        row = Gtk.Box(spacing=10)
        self.btn_show = mk(Gtk.Button(label="Show my license"), "accent")
        self.btn_show.connect("clicked", lambda *_: self.fetch("status"))
        self.btn_check = Gtk.Button(label="Check it with the license server")
        self.btn_check.connect("clicked", lambda *_: self.fetch("check"))
        row.append(self.btn_show)
        row.append(self.btn_check)
        self.root.append(row)
        self.status.set_text("Press Show my license. Soarix will ask for your password.")

    def fetch(self, what):
        def go():
            self.log_clear()
            self.btn_show.set_sensitive(False)
            self.btn_check.set_sensitive(False)
            self.busy(True, "Reading the license ...")
            self.lines = []

            def on_line(ln, partial):
                if not partial:
                    self.lines.append(ln)
                    self.log_add(ln)

            def on_done(rc, err):
                self.busy(False)
                self.btn_show.set_sensitive(True)
                self.btn_check.set_sensitive(True)
                self.render(what, rc)
            self.runner.run(["soarix-license", what], on_line, on_done, admin=True, password=self.password)
        self.need_password("Soarix needs your password to read the license.", go)

    def render(self, what, rc):
        c = self.card
        c.set_visible(True)
        while c.get_first_child():
            c.remove(c.get_first_child())
        rows = []
        for ln in self.lines:
            if ":" in ln:
                k, v = ln.split(":", 1)
                rows.append((k.strip(), v.strip()))
        if what == "status" and rows:
            for i, (k, v) in enumerate(rows):
                c.attach(label(k, "label-key"), 0, i, 1, 1)
                cls = ["label-val"]
                if k.lower() == "status":
                    cls.append("good" if v.lower() == "active" else "warn")
                c.attach(label(v, *cls), 1, i, 1, 1)
            self.status.set_text("")
        else:
            msg = " ".join(self.lines) or "No answer from the license tool."
            c.attach(label(msg, "label-val", wrap=True), 0, 0, 1, 1)
            self.status.set_text("")


class EssentialsPage(Page):
    TITLE = "Soarix Essentials"
    SIZE = (760, 760)

    def __init__(self, app):
        super().__init__(app)
        self.head("Soarix Essentials", "Recommended everyday apps from Flathub. About 2 GB in total.")
        self.checks = {}
        sw = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        installed = self.installed_apps()
        for aid, name, desc, _ in APPS:
            row = mk(Gtk.Box(spacing=14), "approw")
            cb = Gtk.CheckButton()
            cb.set_active(aid not in installed)
            cb.set_sensitive(aid not in installed)
            self.checks[aid] = cb
            row.append(cb)
            txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            txt.append(label(name, "label-val"))
            txt.append(label(desc, "sub", wrap=True))
            row.append(txt)
            if aid in installed:
                row.append(mk(Gtk.Label(label="Installed", valign=Gtk.Align.CENTER), "tag"))
            col.append(row)
        sw.set_child(col)
        self.root.append(sw)
        self.state = self.log_area(110)
        self.root.append(self.state)
        row = Gtk.Box(spacing=10)
        self.go_btn = mk(Gtk.Button(label="Install the selected apps"), "primary")
        self.go_btn.connect("clicked", lambda *_: self.install())
        self.all_btn = Gtk.Button(label="Select all")
        self.all_btn.connect("clicked", lambda *_: [cb.set_active(True) for a, cb in self.checks.items() if cb.get_sensitive()])
        row.append(self.go_btn)
        row.append(self.all_btn)
        self.root.append(row)
        if not any(cb.get_sensitive() for cb in self.checks.values()):
            self.status.set_text("All the recommended apps are already installed.")
            self.go_btn.set_sensitive(False)

    def installed_apps(self):
        try:
            r = subprocess.run(["flatpak", "list", "--app", "--columns=application"], capture_output=True, text=True, timeout=30)
            return set(r.stdout.split())
        except (OSError, subprocess.TimeoutExpired):
            return set()

    def install(self):
        ids = [a for a, cb in self.checks.items() if cb.get_active() and cb.get_sensitive()]
        if not ids:
            self.status.set_text("Nothing selected.")
            return

        def go():
            self.log_clear()
            self.go_btn.set_sensitive(False)
            self.busy(True, "Installing %d app%s. This can take a while ..." % (len(ids), "" if len(ids) == 1 else "s"))

            def on_line(ln, partial):
                if not partial:
                    self.log_add(ln)
                self.status.set_text(ln[:140])

            def on_done(rc, err):
                self.busy(False)
                self.go_btn.set_sensitive(True)
                if rc == 0:
                    self.status.set_text("Done. The new apps are in the Apps drawer.")
                    for a in ids:
                        self.checks[a].set_sensitive(False)
                        self.checks[a].set_active(False)
                    self.go_btn.set_sensitive(False)
                else:
                    self.status.set_text("Something did not install. Check your network and try again.")
            self.runner.run(["flatpak", "install", "-y", "--noninteractive", "flathub"] + ids, on_line, on_done,
                            admin=True, password=self.password)
        self.need_password("Soarix needs your password to install apps.", go)


DT_CONF = os.path.expanduser("~/.config/soarix/datetime.json")


def dt_load():
    try:
        return json.load(open(DT_CONF))
    except (OSError, ValueError):
        return {}


def dt_save(d):
    os.makedirs(os.path.dirname(DT_CONF), exist_ok=True)
    with open(DT_CONF, "w") as f:
        json.dump(d, f)


def timedatectl(prop):
    try:
        return subprocess.run(["timedatectl", "show", "-p", prop, "--value"], capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


class DateTimePage(Page):
    TITLE = "Date & Time"
    SIZE = (700, 720)

    def __init__(self, app):
        super().__init__(app)
        self.head("Date & Time", "Time zone, clock format and automatic time.")
        self.quiet = True
        card = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4), "card")
        self.clock = label("", "big")
        self.day = label("", "sub")
        card.append(self.clock)
        card.append(self.day)
        self.root.append(card)

        grid = mk(Gtk.Grid(row_spacing=16, column_spacing=20), "card")
        zones = subprocess.run(["timedatectl", "list-timezones"], capture_output=True, text=True).stdout.split()
        self.zones = zones or ["UTC"]
        self.dd = Gtk.DropDown.new_from_strings(self.zones)
        self.dd.set_enable_search(True)
        self.dd.set_expression(Gtk.PropertyExpression.new(Gtk.StringObject, None, "string"))
        self.dd.set_hexpand(True)
        cur = timedatectl("Timezone")
        if cur in self.zones:
            self.dd.set_selected(self.zones.index(cur))
        self.zone_btn = mk(Gtk.Button(label="Set time zone"), "primary")
        self.zone_btn.connect("clicked", lambda *_: self.set_zone())
        grid.attach(label("Time zone", "label-val"), 0, 0, 1, 1)
        grid.attach(self.dd, 1, 0, 1, 1)
        grid.attach(self.zone_btn, 2, 0, 1, 1)

        self.sw24 = Gtk.Switch(valign=Gtk.Align.CENTER, halign=Gtk.Align.END)
        self.sw24.set_active(bool(dt_load().get("clock24", False)))
        self.sw24.connect("notify::active", lambda *_: self.on_24())
        grid.attach(label("24-hour (military) time", "label-val"), 0, 1, 2, 1)
        grid.attach(self.sw24, 2, 1, 1, 1)

        self.swbar = Gtk.Switch(valign=Gtk.Align.CENTER, halign=Gtk.Align.END)
        self.swbar.set_active(bool(dt_load().get("show_clock", True)))
        self.swbar.connect("notify::active", lambda *_: self.on_bar())
        grid.attach(label("Show the date and time in the top bar", "label-val"), 0, 2, 2, 1)
        grid.attach(self.swbar, 2, 2, 1, 1)

        self.swntp = Gtk.Switch(valign=Gtk.Align.CENTER, halign=Gtk.Align.END)
        self.swntp.set_active(timedatectl("NTP") == "yes")
        self.swntp.connect("notify::active", lambda *_: self.on_ntp())
        grid.attach(label("Set the time automatically from the internet", "label-val"), 0, 3, 2, 1)
        grid.attach(self.swntp, 2, 3, 1, 1)

        self.manual = Gtk.Box(spacing=10)
        self.date_in = Gtk.Entry(placeholder_text="YYYY-MM-DD", max_width_chars=12)
        self.time_in = Gtk.Entry(placeholder_text="HH:MM  (24-hour)", max_width_chars=12)
        now = time.localtime()
        self.date_in.set_text(time.strftime("%Y-%m-%d", now))
        self.time_in.set_text(time.strftime("%H:%M", now))
        self.set_btn = Gtk.Button(label="Set date and time")
        self.set_btn.connect("clicked", lambda *_: self.set_manual())
        self.manual.append(self.date_in)
        self.manual.append(self.time_in)
        self.manual.append(self.set_btn)
        grid.attach(label("Date and time", "label-val"), 0, 4, 1, 1)
        grid.attach(self.manual, 1, 4, 2, 1)
        self.manual_row = [grid.get_child_at(0, 4), self.manual]
        self.root.append(grid)

        self.state = self.log_area(110)
        self.root.append(self.state)
        self.quiet = False
        self.show_manual()
        GLib.timeout_add_seconds(1, self.tick)
        self.tick()

    def fmt(self):
        return "%H:%M:%S" if self.sw24.get_active() else "%-I:%M:%S %p"

    def tick(self):
        t = time.localtime()
        self.clock.set_text(time.strftime(self.fmt(), t))
        self.day.set_text(time.strftime("%A, %B %-d, %Y", t) + "   " + (time.tzname[t.tm_isdst > 0] if time.tzname else ""))
        return True

    def show_manual(self):
        for w in self.manual_row:
            w.set_visible(not self.swntp.get_active())

    def on_24(self):
        if self.quiet:
            return
        d = dt_load()
        d["clock24"] = self.sw24.get_active()
        dt_save(d)
        subprocess.Popen(["soarix-appearance", "restart-bar"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        self.tick()
        self.status.set_text("Clock format saved. The top bar and the lock screen use it.")

    def on_bar(self):
        if self.quiet:
            return
        d = dt_load()
        d["show_clock"] = self.swbar.get_active()
        dt_save(d)
        subprocess.Popen(["soarix-appearance", "restart-bar"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        self.status.set_text("The date and time are %s in the top bar." % ("shown" if self.swbar.get_active() else "hidden"))

    def run_admin(self, cmd, why, busy_text, done_text, after=None):
        def go():
            self.log_clear()
            self.busy(True, busy_text)

            def on_line(ln, partial):
                if not partial:
                    self.log_add(ln)

            def on_done(rc, err):
                self.busy(False)
                time.tzset()
                self.tick()
                self.status.set_text(done_text if rc == 0 else "That did not work (see the details).")
                if after:
                    after(rc)
            self.runner.run(cmd, on_line, on_done, admin=True, password=self.password)
        self.need_password(why, go)

    def set_zone(self):
        z = self.zones[self.dd.get_selected()]
        self.run_admin(["timedatectl", "set-timezone", z], "Soarix needs your password to change the time zone.",
                       "Changing the time zone ...", "Time zone set to %s." % z)

    def on_ntp(self):
        self.show_manual()
        if self.quiet:
            return
        want = self.swntp.get_active()

        def after(rc):
            if rc != 0:
                self.quiet = True
                self.swntp.set_active(timedatectl("NTP") == "yes")
                self.quiet = False
                self.show_manual()
        self.run_admin(["timedatectl", "set-ntp", "true" if want else "false"], "Soarix needs your password to change the time setting.",
                       "Saving ...", "The time is now set automatically." if want else "Automatic time is off. Set the date and time below.", after)

    def set_manual(self):
        try:
            import datetime
            when = datetime.datetime.strptime(self.date_in.get_text().strip() + " " + self.time_in.get_text().strip(), "%Y-%m-%d %H:%M")
        except ValueError:
            self.status.set_text("Type the date like 2026-11-22 and the time like 14:30.")
            return
        self.run_admin(["timedatectl", "set-time", when.strftime("%Y-%m-%d %H:%M:00")], "Soarix needs your password to set the date and time.",
                       "Setting the date and time ...", "Date and time set.")


class SysInfoPage(Page):
    TITLE = "System Information"
    SIZE = (780, 880)

    def __init__(self, app):
        super().__init__(app)
        self.head("System Information", "About this computer and the edition of Soarix it runs.")
        info = self.load_info()
        top = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4), "card")
        top.append(label("You are running", "sub"))
        top.append(label("Soarix " + info.get("soarix", "?"), "big"))
        top.append(label("%s edition%s" % (info.get("edition", ""), ("   build " + info["build"]) if info.get("build") else ""), "sub"))
        self.root.append(top)

        scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        grid = mk(Gtk.Grid(row_spacing=10, column_spacing=24), "card")
        row = 0
        for lab, key in [("Computer name", "computer_name"), ("Computer", "machine"), ("Processor", "processor"), ("Memory", "memory"),
                         ("Storage", "storage"), ("Graphics", "graphics"), ("Network", "network"), ("Kernel", "kernel"), ("Running for", "uptime")]:
            v = info.get(key)
            if isinstance(v, list):
                v = ", ".join(v) or "not connected"
            if not v:
                continue
            grid.attach(label(lab, "label-key"), 0, row, 1, 1)
            val = label(v, "label-val", wrap=True)
            val.set_hexpand(True)
            val.set_selectable(True)
            grid.attach(val, 1, row, 1, 1)
            row += 1
        col.append(grid)

        ed = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "card")
        ed.append(label("Edition", "heading"))
        ed.append(label("Switch between the command line, the desktop and the server edition. Your files and settings stay. "
                        "The change starts after a restart. Your license must include the edition.", "sub", wrap=True))
        btns = Gtk.Box(spacing=10)
        self.ed_btns = []
        self.ed_list = (("core", "Command line"), ("desktop", "Desktop"), ("server", "Server"))
        for key, name in self.ed_list:
            b = Gtk.Button(label=name)
            b.connect("clicked", lambda _b, k=key, n=name: self.switch(k, n))
            btns.append(b)
            self.ed_btns.append(b)
        ed.append(btns)
        col.append(ed)

        if os.path.exists("/usr/bin/niri"):
            st = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "card")
            st.append(label("How Soarix starts", "heading"))
            st.append(label("Choose what you see after a restart: the command line (the web console at port 9090 is always there) or the "
                            "graphical desktop. You can switch back at any time.", "sub", wrap=True))
            row = Gtk.Box(spacing=10)
            self.start_btns = []
            for key, name in (("off", "Command line"), ("on", "Desktop")):
                b = Gtk.Button(label=name)
                b.connect("clicked", lambda _b, k=key, n=name: self.start_mode(k, n))
                row.append(b)
                self.start_btns.append((b, key))
            st.append(row)
            self.start_note = label("", "sub", wrap=True)
            st.append(self.start_note)
            col.append(st)
            self.show_start_mode()


        adm = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "card")
        adm.append(label("Administrator password", "heading"))
        adm.append(label("Choose how often Soarix asks for your password. \"Only after a restart\" means you type it once after the computer "
                         "starts and not again until the next restart. While a longer choice is on, any program running as you can use "
                         "administrator rights without asking, so keep the normal setting on a shared computer.", "sub", wrap=True))
        self.adm_choices = [("default", "Every 15 minutes (normal)"), ("hour", "Every hour"), ("day", "Every 8 hours"),
                            ("restart", "Only after a restart")]
        self.adm_dd = Gtk.DropDown.new_from_strings([t for _, t in self.adm_choices])
        try:
            now = open("/etc/soarix/admin-mode").read().strip()
        except OSError:
            now = "default"
        self.adm_dd.set_selected(next((i for i, (k, _) in enumerate(self.adm_choices) if k == now), 0))
        arow = Gtk.Box(spacing=10)
        arow.append(self.adm_dd)
        sv = mk(Gtk.Button(label="Save"), "primary")
        sv.connect("clicked", lambda *_: self.adm_save())
        fg = Gtk.Button(label="Ask for the password again now")
        fg.connect("clicked", lambda *_: self.adm_forget())
        arow.append(sv)
        arow.append(fg)
        adm.append(arow)
        col.append(adm)

        up = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "card")
        up.append(label("Upgrade your license", "heading"))
        up.append(label("Have a new key, for example one that adds the server edition? Type it here.", "sub", wrap=True))
        krow = Gtk.Box(spacing=10)
        self.key = Gtk.Entry(placeholder_text="SOAR-XXXX-XXXX-XXXX-XXXX", hexpand=True)
        self.key_btn = mk(Gtk.Button(label="Use this key"), "accent")
        self.key_btn.connect("clicked", lambda *_: self.upgrade())
        krow.append(self.key)
        krow.append(self.key_btn)
        up.append(krow)
        col.append(up)
        scroll.set_child(col)
        self.root.append(scroll)

        self.state = self.log_area(120)
        self.root.append(self.state)
        self.sync_buttons(info)
        self.banner = mk(Gtk.Box(spacing=14), "banner")
        msg = label("The new edition is ready. Restart to start it.", "status", wrap=True)
        msg.set_hexpand(True)
        self.banner.append(msg)
        rb = mk(Gtk.Button(label="Restart now"), "primary")
        rb.connect("clicked", lambda *_: self.admin(["systemctl", "reboot"], "Soarix needs your password to restart.", "Restarting ...", None))
        self.banner.append(rb)
        self.banner.set_visible(False)
        self.root.append(self.banner)

    def show_start_mode(self):
        cur = subprocess.run(["systemctl", "get-default"], capture_output=True, text=True).stdout.strip()
        desktop = cur == "graphical.target"
        for b, key in self.start_btns:
            here = (key == "on") == desktop
            b.set_sensitive(not here)
            b.set_label(("Desktop" if key == "on" else "Command line") + ("   (now)" if here else ""))

    def start_mode(self, key, name):
        def after(rc):
            self.show_start_mode()
            self.status.set_text(("%s will start at the next restart." % name) if rc == 0 else "That did not work (see the details).")
        self.admin(["soarix-desktop", key, "--next-boot"], "Soarix needs your password to change how it starts.",
                   "Saving ...", after)

    def adm_save(self):
        key, text = self.adm_choices[self.adm_dd.get_selected()]
        self.admin(["soarix-admin-mode", "set", key], "Soarix needs your password to change this setting.",
                   "Saving ...", lambda rc: self.status.set_text(("Saved: " + text + ".") if rc == 0 else "That did not work (see the details)."))

    def adm_forget(self):
        subprocess.run(["sudo", "-K"], capture_output=True)
        self.password = None
        self.status.set_text("The password is forgotten. Soarix will ask again the next time it needs it.")

    def sync_buttons(self, info=None):
        """Edition buttons: the current one and the ones the license does not include are not clickable."""
        info = info or self.load_info()
        lic = info.get("licensed")  # None = not known yet, so the command itself decides
        for b, (key, name) in zip(self.ed_btns, self.ed_list):
            here = info.get("edition") == name
            blocked = lic is not None and key not in lic
            b.set_sensitive(not here and not blocked)
            b.set_label(name + ("   (this one)" if here else ("   (needs an upgraded key)" if blocked else "")))

    def load_info(self):
        try:
            return json.loads(subprocess.run(["soarix-info", "--json"], capture_output=True, text=True, timeout=20).stdout)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            return {}

    def admin(self, cmd, why, busy_text, done, stdin=None):
        def go():
            self.log_clear()
            self.banner.set_visible(False)
            self.key_btn.set_sensitive(False)
            for b in self.ed_btns:
                b.set_sensitive(False)
            self.busy(True, busy_text)
            self.seen = []

            def on_line(ln, partial):
                if not partial:
                    self.log_add(ln)
                    self.seen.append(ln)
                self.status.set_text(ln[:140])

            def on_done(rc, err):
                self.busy(False)
                self.key_btn.set_sensitive(True)
                self.sync_buttons()
                if done:
                    done(rc)
            self.runner.run(cmd, on_line, on_done, admin=True, password=self.password, extra_stdin=stdin)
        self.need_password(why, go)

    def switch(self, key, name):
        def after(rc):
            text = " ".join(self.seen)
            if "starts at the next restart" in text:
                self.banner.set_visible(True)
                self.status.set_text("The %s edition is downloaded. Restart to start it." % name)
            elif rc != 0:
                self.status.set_text(self.seen[-1] if self.seen else "That did not finish.")
        self.admin(["soarix-edition", "switch", key], "Soarix needs your password to switch to the %s edition." % name,
                   "Switching to the %s edition ..." % name, after)

    def upgrade(self):
        k = self.key.get_text().strip()
        if not k:
            self.status.set_text("Type your new license key first.")
            return

        def after(rc):
            self.status.set_text("License updated. See the details for what it now includes." if rc == 0
                                 else (self.seen[-1] if self.seen else "That key was not accepted."))
        self.admin(["soarix-edition", "upgrade", "-"], "Soarix needs your password to change the license.", "Checking the key ...", after, stdin=k + "\n")


class ServicesPage(Page):
    TITLE = "Server Services"
    SIZE = (800, 820)

    def __init__(self, app):
        super().__init__(app)
        self.head("Server Services", "Turn the hosting pieces on and off. Nothing runs until you turn it on.")
        self.quiet = True
        self.rows = {}
        top = Gtk.Box(spacing=12)
        note = label("Manage opens a window for each service. For sites, mail domains, DNS zones and databases, use the NovaCPX add-on (coming) or the web console.", "sub", wrap=True)
        note.set_hexpand(True)
        top.append(note)
        wc = Gtk.Button(label="Open the web console")
        wc.connect("clicked", lambda *_: subprocess.Popen(["xdg-open", "https://localhost:9090"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
        top.append(wc)
        self.root.append(top)
        scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for g in self.groups():
            row = mk(Gtk.Box(spacing=14), "approw")
            sw = Gtk.Switch(valign=Gtk.Align.CENTER)
            sw.set_active(bool(g["on"]))
            sw.connect("notify::active", lambda _s, _p, grp=g: self.toggled(grp))
            row.append(sw)
            txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            txt.append(label(g["description"], "label-val", wrap=True))
            ports = ("Opens: " + ", ".join(g["firewall"])) if g["firewall"] else "No ports opened"
            txt.append(label("%s   %s" % (g["group"], ports), "sub", wrap=True))
            row.append(txt)
            state = label("", "tag")
            row.append(state)
            mb = Gtk.Button(label="Manage")
            mb.connect("clicked", lambda _b, grp=g: GroupWindow(self, grp).present())
            row.append(mb)
            col.append(row)
            self.rows[g["group"]] = (sw, state)
        scroll.set_child(col)
        self.root.append(scroll)
        self.state = self.log_area(110)
        self.root.append(self.state)
        self.refresh()
        self.quiet = False

    def groups(self):
        try:
            return json.loads(subprocess.run(["soarix-server", "list", "--json"], capture_output=True, text=True, timeout=60).stdout)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            return []

    def refresh(self):
        self.quiet = True
        for g in self.groups():
            sw, st = self.rows[g["group"]]
            sw.set_active(bool(g["on"]))
            running = [u["unit"] for u in g["units"] if u["state"] == "active"]
            st.set_text("Running" if running else ("On, not running" if g["on"] else "Off"))
            if running or g["on"]:
                st.remove_css_class("tag-off")
            else:
                st.add_css_class("tag-off")
        self.quiet = False

    def toggled(self, g):
        if self.quiet:
            return
        sw, _ = self.rows[g["group"]]
        want = sw.get_active()
        name = g["group"]
        if want:
            cmd = "soarix-server enable %s" % name
            if g["firewall"]:
                cmd += " && soarix-server firewall %s" % name
            busy = "Turning on %s ..." % name
            done = "%s is on%s." % (name, (" and its ports (%s) are open" % ", ".join(g["firewall"])) if g["firewall"] else "")
        else:
            cmd, busy, done = "soarix-server disable %s" % name, "Turning off %s ..." % name, "%s is off." % name

        def go():
            self.log_clear()
            self.busy(True, busy)

            def on_line(ln, partial):
                if not partial:
                    self.log_add(ln)

            def on_done(rc, err):
                self.busy(False)
                self.refresh()
                self.status.set_text(done if rc == 0 else "That did not finish (see the details).")
            self.runner.run(["sh", "-c", cmd], on_line, on_done, admin=True, password=self.password)

        def cancelled_check():
            go()
        if self.password is None:
            self.need_password("Soarix needs your password to change a server service.", cancelled_check)
        else:
            go()


CHECKS = {
    "web": "nginx -t && php-fpm -t",
    "apache": "httpd -t && php-fpm -t",
    "dns": "unbound-checkconf",
    "ns": "named-checkconf",
    "mail": "postfix check",
    "proxy": "haproxy -c -f /etc/haproxy/haproxy.cfg",
    "security": "fail2ban-client -t",
}


class GroupWindow(Gtk.Window):
    """Start, stop, restart, check the settings and read the recent log of one server service group."""

    def __init__(self, page, g):
        super().__init__(transient_for=page, title=g["description"])
        mk(self, "soarix-dialog")
        self.page, self.g = page, g
        self.units = ["%s.service" % u["unit"] for u in g["units"]]
        self.set_default_size(720, 580)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        for m in ("top", "bottom", "start", "end"):
            getattr(box, "set_margin_" + m)(22)
        box.append(label(g["description"], "heading", wrap=True))
        box.append(label("Services: " + ", ".join(u["unit"] for u in g["units"]) +
                         (("      Ports: " + ", ".join(g["firewall"])) if g["firewall"] else ""), "sub", wrap=True))
        row = Gtk.Box(spacing=10)
        for text, verb in (("Start", "start"), ("Stop", "stop"), ("Restart", "restart")):
            b = mk(Gtk.Button(label=text), "primary") if verb == "restart" else Gtk.Button(label=text)
            b.connect("clicked", lambda _b, v=verb: self.run_cmd("systemctl %s %s" % (v, " ".join(self.units)), "%s ..." % text))
            row.append(b)
        if g["group"] in CHECKS:
            cb = mk(Gtk.Button(label="Check the settings"), "accent")
            cb.connect("clicked", lambda *_: self.run_cmd(CHECKS[g["group"]], "Checking the settings ..."))
            row.append(cb)
        lb = Gtk.Button(label="Show the recent log")
        lb.connect("clicked", lambda *_: self.run_cmd("journalctl -n 80 --no-pager " + " ".join("-u " + u for u in self.units), "Reading the log ..."))
        row.append(lb)
        box.append(row)
        self.status = label("", "status", wrap=True)
        box.append(self.status)
        self.progress = Gtk.ProgressBar()
        self.progress.set_visible(False)
        box.append(self.progress)
        self.view = mk(Gtk.TextView(editable=False, cursor_visible=False, monospace=True), "log")
        self.view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.view.set_left_margin(10)
        self.view.set_right_margin(10)
        sw = mk(Gtk.ScrolledWindow(vexpand=True), "logbox")
        sw.set_child(self.view)
        box.append(sw)
        close = Gtk.Button(label="Close", halign=Gtk.Align.END)
        close.connect("clicked", lambda *_: self.close())
        box.append(close)
        self.set_child(box)
        self.pulse_id = None

    def say(self, text):
        b = self.view.get_buffer()
        b.insert(b.get_end_iter(), text + "\n")

    def run_cmd(self, cmd, busy_text):
        def go():
            self.view.get_buffer().set_text("")
            self.status.set_text(busy_text)
            self.progress.set_visible(True)
            self.pulse_id = GLib.timeout_add(120, lambda: (self.progress.pulse(), True)[1])

            def on_line(ln, partial):
                if not partial:
                    self.say(ln)

            def on_done(rc, err):
                if self.pulse_id is not None:
                    GLib.source_remove(self.pulse_id)
                    self.pulse_id = None
                self.progress.set_visible(False)
                self.status.set_text("Done." if rc == 0 else "That reported a problem (see below).")
                self.page.refresh()
            self.page.runner.run(["sh", "-c", cmd], on_line, on_done, admin=True, password=self.page.password)
        self.page.need_password("Soarix needs your password to manage this service.", go)


def cli(tool, *args):
    """Run a Soarix settings command (no administrator rights needed) and return its output."""
    try:
        return subprocess.run([tool] + list(args), capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None


def cli_json(tool, *args):
    r = cli(tool, *args)
    try:
        return json.loads(r.stdout) if r and r.returncode == 0 else {}
    except ValueError:
        return {}


class AppearancePage(Page):
    TITLE = "Appearance"
    SIZE = (900, 860)

    def __init__(self, app):
        super().__init__(app)
        self.head("Appearance", "Wallpaper, light or dark theme, and accent color.")
        self.st = cli_json("soarix-appearance", "state")
        scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)

        wc = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "card")
        wc.append(label("Wallpaper", "heading"))
        self.flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, min_children_per_line=2, max_children_per_line=3,
                                column_spacing=12, row_spacing=12, homogeneous=True)
        self.thumbs = {}
        for w in self.st.get("wallpapers", []):
            btn = mk(Gtk.Button(), "thumb")
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            pic = Gtk.Picture.new_for_filename(w["path"])
            pic.set_content_fit(Gtk.ContentFit.CONTAIN)
            pic.set_can_shrink(True)
            pic.set_size_request(320, 180)
            box.append(pic)
            box.append(label(w["name"], "sub"))
            btn.set_child(box)
            btn.connect("clicked", lambda _b, p=w["path"]: self.pick_wallpaper(p))
            self.flow.append(btn)
            self.thumbs[w["path"]] = btn
        wc.append(self.flow)
        own = Gtk.Button(label="Use my own picture ...", halign=Gtk.Align.START)
        own.connect("clicked", lambda *_: self.own_picture())
        wc.append(own)
        col.append(wc)

        tc = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "card")
        tc.append(label("Theme", "heading"))
        trow = Gtk.Box(spacing=10)
        self.theme_btns = {}
        for key, text in (("dark", "Dark"), ("light", "Light")):
            b = Gtk.Button(label=text)
            b.connect("clicked", lambda _b, k=key: self.pick_theme(k))
            trow.append(b)
            self.theme_btns[key] = b
        tc.append(trow)
        col.append(tc)

        ac = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "card")
        ac.append(label("Accent color", "heading"))
        arow = Gtk.Box(spacing=10)
        self.swatches = {}
        for a in self.st.get("accents", []):
            b = mk(Gtk.Button(label=""), "swatch", "sw-" + a["name"])
            b.set_tooltip_text(a["label"])
            b.connect("clicked", lambda _b, n=a["name"]: self.pick_accent(n))
            arow.append(b)
            self.swatches[a["name"]] = b
        ac.append(arow)
        col.append(ac)

        wn = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "card")
        wn.append(label("Windows", "heading"))
        wn.append(label("Choose how new windows open. Side by side keeps everything in a row you scroll through. Overlapping lets you "
                        "drag windows around and stack them like a traditional desktop. You can also press Super+V to float or "
                        "tile one window.", "sub", wrap=True))
        wrow = Gtk.Box(spacing=10)
        self.win_btns = {}
        for key, text in (("tiled", "Side by side"), ("floating", "Overlapping")):
            b = Gtk.Button(label=text)
            b.connect("clicked", lambda _b, k=key: self.pick_windows(k))
            wrow.append(b)
            self.win_btns[key] = b
        wn.append(wrow)
        col.append(wn)

        rb = Gtk.Button(label="Reset to the Soarix defaults", halign=Gtk.Align.START)
        rb.connect("clicked", lambda *_: self.reset())
        col.append(rb)
        scroll.set_child(col)
        self.root.append(scroll)
        self.state = self.log_area(60)
        self.root.append(self.state)
        self.show_state()

    def show_state(self):
        for p, b in self.thumbs.items():
            (b.add_css_class if p == self.st.get("wallpaper") else b.remove_css_class)("selected")
        for k, b in self.theme_btns.items():
            b.set_label(("Dark" if k == "dark" else "Light") + ("   (now)" if k == self.st.get("theme") else ""))
            (b.add_css_class if k == self.st.get("theme") else b.remove_css_class)("primary")
        for n, b in self.swatches.items():
            b.set_label("\u2713" if n == self.st.get("accent") else "")
        for k, b in self.win_btns.items():
            on = k == self.st.get("windows", "tiled")
            b.set_label(("Side by side" if k == "tiled" else "Overlapping") + ("   (now)" if on else ""))
            (b.add_css_class if on else b.remove_css_class)("primary")

    def refresh(self, say):
        self.st = cli_json("soarix-appearance", "state") or self.st
        self.show_state()
        self.status.set_text(say)

    def pick_wallpaper(self, path):
        cli("soarix-appearance", "wallpaper", path)
        self.refresh("Wallpaper changed. It is used every time you sign in.")

    def own_picture(self):
        dlg = Gtk.FileDialog(title="Choose a picture")

        def done(d, res):
            try:
                f = d.open_finish(res)
            except GLib.Error:
                return
            if f and f.get_path():
                cli("soarix-appearance", "wallpaper", f.get_path())
                self.refresh("Wallpaper changed. It is used every time you sign in.")
        dlg.open(self, None, done)

    def pick_theme(self, key):
        cli("soarix-appearance", "theme", key)
        self.refresh("Theme changed. Apps that are already open may need to be reopened.")

    def pick_windows(self, key):
        cli("soarix-appearance", "windows", key)
        self.refresh("Windows now open %s." % ("overlapping, like a traditional desktop" if key == "floating" else "side by side"))

    def pick_accent(self, name):
        cli("soarix-appearance", "accent", name)
        self.refresh("Accent color changed.")

    def reset(self):
        cli("soarix-appearance", "reset")
        self.refresh("Appearance reset to the Soarix defaults.")


class KeepWindow(Gtk.Window):
    """'Keep this setting?' with a countdown: if nobody answers, the old setting comes back by itself."""

    def __init__(self, parent, on_keep, on_revert, seconds=15):
        super().__init__(transient_for=parent, modal=True, title="Keep this setting?")
        mk(self, "soarix-dialog")
        self.on_keep, self.on_revert, self.left, self.done = on_keep, on_revert, seconds, False
        self.set_default_size(420, -1)
        self.set_resizable(False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        for m in ("top", "bottom", "start", "end"):
            getattr(box, "set_margin_" + m)(24)
        box.append(label("Keep this setting?", "heading"))
        self.msg = label("", "sub", wrap=True)
        box.append(self.msg)
        row = Gtk.Box(spacing=10, halign=Gtk.Align.END)
        back = Gtk.Button(label="Go back")
        back.connect("clicked", lambda *_: self.finish(False))
        keep = mk(Gtk.Button(label="Keep this setting"), "primary")
        keep.connect("clicked", lambda *_: self.finish(True))
        row.append(back)
        row.append(keep)
        box.append(row)
        self.set_child(box)
        self.connect("close-request", lambda *_: (self.finish(False), False)[1])
        self.tick()
        GLib.timeout_add_seconds(1, self.tick)

    def tick(self):
        if self.done:
            return False
        self.msg.set_text("If you do nothing, the old setting comes back in %d seconds." % self.left)
        if self.left <= 0:
            self.finish(False)
            return False
        self.left -= 1
        return True

    def finish(self, keep):
        if self.done:
            return
        self.done = True
        (self.on_keep if keep else self.on_revert)()
        self.close()


class DisplayPage(Page):
    TITLE = "Display Settings"
    SIZE = (760, 820)

    def __init__(self, app):
        super().__init__(app)
        self.head("Display Settings", "Screen size, size of text and icons, lock screen and screen saver.")
        self.st = cli_json("soarix-display", "state")
        self.quiet = True
        scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)

        sc = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "card")
        sc.append(label("Screen", "heading"))
        grid = Gtk.Grid(row_spacing=12, column_spacing=20)
        self.res = [tuple(r) for r in self.st.get("resolutions", [])]
        self.res_dd = Gtk.DropDown.new_from_strings(["%d x %d" % r for r in self.res] or ["not available"])
        self.res_dd.set_hexpand(True)
        cur = (self.st.get("width"), self.st.get("height"))
        if cur in self.res:
            self.res_dd.set_selected(self.res.index(cur))
        self.scales = self.st.get("scales", [])
        self.scale_dd = Gtk.DropDown.new_from_strings([t for t, _ in self.scales] or ["not available"])
        self.scale_dd.set_hexpand(True)
        for i, (_, v) in enumerate(self.scales):
            if abs(v - float(self.st.get("scale", 1.0))) < 0.01:
                self.scale_dd.set_selected(i)
        grid.attach(label("Resolution", "label-val"), 0, 0, 1, 1)
        grid.attach(self.res_dd, 1, 0, 1, 1)
        grid.attach(label("Text and icon size", "label-val"), 0, 1, 1, 1)
        grid.attach(self.scale_dd, 1, 1, 1, 1)
        sc.append(grid)
        ap = mk(Gtk.Button(label="Apply", halign=Gtk.Align.START), "primary")
        ap.connect("clicked", lambda *_: self.apply_screen())
        sc.append(ap)
        if not self.st.get("output"):
            sc.append(label("The screen list is not available. Is the desktop running?", "warn", wrap=True))
        col.append(sc)

        lc = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "card")
        lc.append(label("Lock screen and screen saver", "heading"))
        lg = Gtk.Grid(row_spacing=12, column_spacing=20)
        self.minutes = self.st.get("minutes", [])
        self.lock_dd = Gtk.DropDown.new_from_strings([t for t, _ in self.minutes] or ["not available"])
        self.off_dd = Gtk.DropDown.new_from_strings([t for t, _ in self.minutes] or ["not available"])
        for dd, key in ((self.lock_dd, "lock"), (self.off_dd, "off")):
            dd.set_hexpand(True)
            for i, (_, v) in enumerate(self.minutes):
                if v == self.st.get(key):
                    dd.set_selected(i)
        self.lock_dd.connect("notify::selected", lambda *_: self.save_minutes("lock-after", self.lock_dd))
        self.off_dd.connect("notify::selected", lambda *_: self.save_minutes("off-after", self.off_dd))
        lg.attach(label("Lock the screen after", "label-val"), 0, 0, 1, 1)
        lg.attach(self.lock_dd, 1, 0, 1, 1)
        lg.attach(label("Screen saver (turns the screen off) after", "label-val"), 0, 1, 1, 1)
        lg.attach(self.off_dd, 1, 1, 1, 1)
        lc.append(lg)
        ln = Gtk.Button(label="Lock the screen now", halign=Gtk.Align.START)
        ln.connect("clicked", lambda *_: subprocess.Popen(["soarix-display", "lock"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                                           stderr=subprocess.DEVNULL, start_new_session=True))
        lc.append(ln)
        col.append(lc)

        rs = Gtk.Button(label="Reset to the recommended setting", halign=Gtk.Align.START)
        rs.connect("clicked", lambda *_: self.reset())
        col.append(rs)
        scroll.set_child(col)
        self.root.append(scroll)
        self.state = self.log_area(60)
        self.root.append(self.state)
        self.quiet = False

    def apply_screen(self):
        if not self.res:
            return
        old = (self.st.get("width"), self.st.get("height"), float(self.st.get("scale", 1.0)))
        w, h = self.res[self.res_dd.get_selected()]
        sv = self.scales[self.scale_dd.get_selected()][1] if self.scales else old[2]
        if (w, h, sv) == old:
            self.status.set_text("That is already the current setting.")
            return
        cli("soarix-display", "mode", "%dx%d" % (w, h))
        cli("soarix-display", "scale", "%g" % sv)

        def keep():
            cli("soarix-display", "keep")
            self.st = cli_json("soarix-display", "state") or self.st
            self.status.set_text("Saved. It is used every time you sign in.")

        def revert():
            cli("soarix-display", "mode", "%dx%d" % (old[0], old[1]))
            cli("soarix-display", "scale", "%g" % old[2])
            self.status.set_text("Went back to the old setting.")
        KeepWindow(self, keep, revert).present()

    def save_minutes(self, what, dd):
        if self.quiet or not self.minutes:
            return
        v = self.minutes[dd.get_selected()][1]
        cli("soarix-display", what, str(v))
        self.status.set_text("Saved. It is used every time you sign in.")

    def reset(self):
        cli("soarix-display", "reset")
        self.status.set_text("Reset. Reopen this window to see the new values.")


HOSTCHARS = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,252}$")


def out_of(cmd, timeout=30):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def nm_fields(line):
    """Split one line of 'nmcli -t' output (colons inside values are escaped as backslash-colon)."""
    parts, cur, esc = [], "", False
    for ch in line:
        if esc:
            cur += ch
            esc = False
        elif ch == chr(92):
            esc = True
        elif ch == ":":
            parts.append(cur)
            cur = ""
        else:
            cur += ch
    parts.append(cur)
    return parts


def wifi_connect(ssid, pw, timeout=45):
    """Join a Wi-Fi network. The password is typed to nmcli on a terminal, never put on the command line
    (other users on this computer can read command lines)."""
    import pty
    import select
    pid, fd = pty.fork()
    if pid == 0:
        os.execvp("nmcli", ["nmcli", "--ask", "device", "wifi", "connect", ssid] if pw else ["nmcli", "device", "wifi", "connect", ssid])
    out, sent, end = b"", False, time.time() + timeout
    while time.time() < end:
        r, _, _ = select.select([fd], [], [], 1)
        if not r:
            continue
        try:
            chunk = os.read(fd, 4096)
        except OSError:
            break
        if not chunk:
            break
        out += chunk
        if pw and not sent and re.search(rb"[Pp]assword", out):
            os.write(fd, (pw + "\n").encode())
            sent = True
    try:
        _, status = os.waitpid(pid, 0)
        rc = os.waitstatus_to_exitcode(status)
    except (ChildProcessError, OSError):
        rc = 1
    return rc, ANSI.sub("", out.decode("utf-8", "replace")).replace(pw or "\0", "")


class WifiPassword(Gtk.Window):
    def __init__(self, parent, ssid, on_ok):
        super().__init__(transient_for=parent, modal=True, title="Wi-Fi password")
        mk(self, "soarix-dialog")
        self.on_ok = on_ok
        self.set_default_size(420, -1)
        self.set_resizable(False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        for m in ("top", "bottom", "start", "end"):
            getattr(box, "set_margin_" + m)(24)
        box.append(label("Join %s" % ssid, "heading", wrap=True))
        self.entry = Gtk.PasswordEntry(show_peek_icon=True)
        self.entry.connect("activate", self.go)
        box.append(self.entry)
        row = Gtk.Box(spacing=10, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda *_: self.close())
        ok = mk(Gtk.Button(label="Connect"), "primary")
        ok.connect("clicked", self.go)
        row.append(cancel)
        row.append(ok)
        box.append(row)
        self.set_child(box)
        self.entry.grab_focus()

    def go(self, *_):
        pw = self.entry.get_text()
        if pw:
            self.close()
            self.on_ok(pw)


class NetworkPage(Page):
    TITLE = "Network"
    SIZE = (880, 1000)
    TOOLS = [("Ping", "Check that a computer or website answers"), ("Traceroute", "See the path to a computer"),
             ("DNS lookup", "Find the address of a name"), ("Port scan", "Which common ports are open on a computer"),
             ("Who owns it", "Look up who registered a name or address"), ("Speed test", "Measure the internet speed"),
             ("My public address", "The address the internet sees")]

    def __init__(self, app):
        super().__init__(app)
        self.head("Network", "Connections, Wi-Fi and network tools.")
        scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)

        cc = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "card")
        cc.append(label("Connections", "heading"))
        self.conns = Gtk.Grid(row_spacing=8, column_spacing=22)
        cc.append(self.conns)
        crow = Gtk.Box(spacing=10)
        rf = Gtk.Button(label="Refresh")
        rf.connect("clicked", lambda *_: self.load_all())
        adv = Gtk.Button(label="Advanced network settings")
        adv.connect("clicked", lambda *_: self.spawn(["nm-connection-editor"]))
        crow.append(rf)
        crow.append(adv)
        cc.append(crow)
        col.append(cc)

        self.wifi_card = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "card")
        wh = Gtk.Box(spacing=10)
        t = label("Wi-Fi", "heading")
        t.set_hexpand(True)
        wh.append(t)
        self.wifi_sw = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.wifi_sw.connect("notify::active", lambda *_: self.on_wifi_switch())
        wh.append(self.wifi_sw)
        self.wifi_card.append(wh)
        self.wifi_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.wifi_card.append(self.wifi_list)
        scan = Gtk.Button(label="Scan for networks", halign=Gtk.Align.START)
        scan.connect("clicked", lambda *_: self.scan_wifi(True))
        self.wifi_card.append(scan)
        col.append(self.wifi_card)

        tc = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "card")
        tc.append(label("Network tools", "heading"))
        row = Gtk.Box(spacing=10)
        self.tool_dd = Gtk.DropDown.new_from_strings([n for n, _ in self.TOOLS])
        self.tool_dd.connect("notify::selected", lambda *_: self.tool_hint())
        self.target = Gtk.Entry(placeholder_text="Name or address, for example example.com", hexpand=True)
        self.target.connect("activate", lambda *_: self.run_tool())
        go = mk(Gtk.Button(label="Run"), "primary")
        go.connect("clicked", lambda *_: self.run_tool())
        row.append(self.tool_dd)
        row.append(self.target)
        row.append(go)
        tc.append(row)
        self.hint = label("", "sub", wrap=True)
        tc.append(self.hint)
        col.append(tc)
        scroll.set_child(col)
        self.root.append(scroll)
        self.state = self.log_area(140)
        self.root.append(self.state)
        self.details.set_expanded(True)
        self.details.set_visible(True)
        self.quiet = True
        self.tool_hint()
        self.load_all()
        self.quiet = False

    def spawn(self, cmd):
        try:
            subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            self.status.set_text("That program is not installed.")

    def load_all(self):
        c = self.conns
        while c.get_first_child():
            c.remove(c.get_first_child())
        i = 0
        for ln in out_of(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device", "status"]).splitlines():
            dev, typ, st, con = (nm_fields(ln) + ["", "", "", ""])[:4]
            if typ in ("loopback", "bridge", "tun") or dev.startswith(("lo", "docker", "veth", "virbr", "podman", "br-")):
                continue
            ip = out_of(["nmcli", "-g", "IP4.ADDRESS", "device", "show", dev]).split()
            c.attach(label(dev + "   (" + {"ethernet": "cable", "wifi": "Wi-Fi"}.get(typ, typ) + ")", "label-val"), 0, i, 1, 1)
            c.attach(label(("connected to " + con) if st == "connected" else st, "good" if st == "connected" else "label-key"), 1, i, 1, 1)
            c.attach(label(", ".join(ip) if ip else "", "label-key"), 2, i, 1, 1)
            i += 1
        if not i:
            c.attach(label("No network connections found. Is NetworkManager running?", "warn"), 0, 0, 1, 1)
        radio = out_of(["nmcli", "radio", "wifi"]).strip()
        self.wifi_card.set_visible(bool(out_of(["nmcli", "-t", "-f", "TYPE", "device"]).count("wifi")))
        was = self.quiet
        self.quiet = True
        self.wifi_sw.set_active(radio == "enabled")
        self.quiet = was
        if radio == "enabled":
            self.scan_wifi(False)

    def on_wifi_switch(self):
        if self.quiet:
            return
        out_of(["nmcli", "radio", "wifi", "on" if self.wifi_sw.get_active() else "off"])
        self.load_all()

    def scan_wifi(self, rescan):
        box = self.wifi_list
        while box.get_first_child():
            box.remove(box.get_first_child())
        seen = set()
        lines = out_of(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "device", "wifi", "list", "--rescan", "yes" if rescan else "auto"], 40).splitlines()
        for ln in lines:
            use, ssid, sig, sec = (nm_fields(ln) + ["", "", "", ""])[:4]
            if not ssid or ssid in seen:
                continue
            seen.add(ssid)
            r = mk(Gtk.Box(spacing=14), "approw")
            txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            txt.append(label(ssid, "label-val"))
            txt.append(label("Signal %s%%   %s" % (sig, sec if sec else "open network"), "sub"))
            r.append(txt)
            if use.strip() == "*":
                r.append(mk(Gtk.Label(label="Connected", valign=Gtk.Align.CENTER), "tag"))
            else:
                b = Gtk.Button(label="Connect")
                b.connect("clicked", lambda _b, s=ssid, secured=bool(sec): self.join(s, secured))
                r.append(b)
            box.append(r)
        if not seen:
            box.append(label("No Wi-Fi networks found yet. Press Scan.", "sub"))

    def join(self, ssid, secured):
        def go(pw=None):
            self.log_clear()
            self.busy(True, "Connecting to %s ..." % ssid)

            def work():
                rc, text = wifi_connect(ssid, pw)
                GLib.idle_add(done, rc, text)

            def done(rc, text):
                for ln in text.splitlines():
                    if ln.strip():
                        self.log_add(ln.strip())
                self.busy(False)
                self.status.set_text(("Connected to %s." % ssid) if rc == 0 else "Could not connect. Check the password and try again.")
                self.load_all()
            threading.Thread(target=work, daemon=True).start()
        if secured:
            WifiPassword(self, ssid, go).present()
        else:
            go()

    def tool_hint(self):
        name, desc = self.TOOLS[self.tool_dd.get_selected()]
        self.hint.set_text(desc + (".  Needs no name." if name in ("Speed test", "My public address") else "."))
        self.target.set_sensitive(name not in ("Speed test", "My public address"))

    def run_tool(self):
        name = self.TOOLS[self.tool_dd.get_selected()][0]
        t = self.target.get_text().strip()
        if name not in ("Speed test", "My public address") and not HOSTCHARS.match(t):
            self.status.set_text("Type a name or address first (letters, numbers, dots and dashes only).")
            return
        trace = ["traceroute", "-w", "2", "-m", "20", t] if shutil.which("traceroute") else ["tracepath", t]
        cmd = {"Ping": ["ping", "-c", "4", t], "Traceroute": trace, "DNS lookup": ["dig", "+noall", "+answer", "+stats", t],
               "Port scan": ["nmap", "-F", t], "Who owns it": ["whois", t], "Speed test": ["speedtest-cli", "--simple"],
               "My public address": ["curl", "-s", "--max-time", "15", "https://ifconfig.me"]}[name]
        if not shutil.which(cmd[0]):
            self.status.set_text("%s is not installed on this computer." % cmd[0])
            return
        self.log_clear()
        self.busy(True, "%s ..." % name)

        def on_line(ln, partial):
            if not partial:
                self.log_add(ln)

        def on_done(rc, err):
            self.busy(False)
            self.status.set_text("Done." if rc == 0 else "Finished with a problem (see the output).")
        self.runner.run(cmd, on_line, on_done)


class PrintersPage(Page):
    TITLE = "Printers"
    SIZE = (820, 800)

    def __init__(self, app):
        super().__init__(app)
        self.head("Printers", "Add printers, choose the default and print a test page.")
        self.listbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.set_child(self.listbox)
        self.root.append(scroll)
        self.state = self.log_area(150)
        self.root.append(self.state)
        row = Gtk.Box(spacing=10)
        find = mk(Gtk.Button(label="Find printers"), "primary")
        find.connect("clicked", lambda *_: self.find())
        adv = Gtk.Button(label="Advanced printer settings")
        adv.connect("clicked", lambda *_: subprocess.Popen(["system-config-printer"], stdin=subprocess.DEVNULL,
                                                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True))
        row.append(find)
        row.append(adv)
        self.root.append(row)
        self.load()

    def load(self):
        box = self.listbox
        while box.get_first_child():
            box.remove(box.get_first_child())
        txt = out_of(["lpstat", "-p", "-d", "-v"])
        if not txt.strip():
            msg = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10), "card")
            msg.append(label("No printers yet", "heading"))
            msg.append(label("Press Find printers to look for printers on your network and USB. If nothing is found, the printing "
                             "service may be off.", "sub", wrap=True))
            on = Gtk.Button(label="Turn on the printing service", halign=Gtk.Align.START)
            on.connect("clicked", lambda *_: self.admin(["sh", "-c", "systemctl enable --now cups.socket cups.service"],
                                                        "Soarix needs your password to turn on printing.", "Turning on printing ..."))
            msg.append(on)
            box.append(msg)
            return
        default, names, uris = "", [], {}
        for ln in txt.splitlines():
            m = re.match(r"printer (\S+) (.*)", ln)
            if m:
                names.append((m.group(1), m.group(2)))
            m = re.match(r"system default destination: (\S+)", ln)
            if m:
                default = m.group(1)
            m = re.match(r"device for (\S+): (\S+)", ln)
            if m:
                uris[m.group(1)] = m.group(2)
        for name, state in names:
            r = mk(Gtk.Box(spacing=12), "approw")
            t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            t.append(label(name + ("   (default)" if name == default else ""), "label-val"))
            t.append(label("%s   %s" % ("Ready" if "idle" in state else ("Off" if "disabled" in state else state[:40]), uris.get(name, "")), "sub", wrap=True))
            r.append(t)
            if name != default:
                d = Gtk.Button(label="Make default")
                d.connect("clicked", lambda _b, n=name: self.admin(["lpadmin", "-d", n], "Soarix needs your password to change the default printer.",
                                                                    "Setting the default ..."))
                r.append(d)
            tp = Gtk.Button(label="Test page")
            tp.connect("clicked", lambda _b, n=name: self.test_page(n))
            r.append(tp)
            rm = Gtk.Button(label="Remove")
            rm.connect("clicked", lambda _b, n=name: self.admin(["lpadmin", "-x", n], "Soarix needs your password to remove a printer.", "Removing ..."))
            r.append(rm)
            box.append(r)

    def test_page(self, name):
        self.log_clear()
        self.busy(True, "Sending a test page to %s ..." % name)

        def on_line(ln, partial):
            if not partial:
                self.log_add(ln)

        def on_done(rc, err):
            self.busy(False)
            self.status.set_text("Test page sent." if rc == 0 else "The test page could not be sent (see the details).")
        self.runner.run(["lp", "-d", name, "/usr/share/cups/data/default-testpage.pdf"], on_line, on_done)

    def admin(self, cmd, why, busy_text):
        def go():
            self.log_clear()
            self.busy(True, busy_text)

            def on_line(ln, partial):
                if not partial:
                    self.log_add(ln)

            def on_done(rc, err):
                self.busy(False)
                self.status.set_text("Done." if rc == 0 else "That did not work (see the details).")
                self.load()
            self.runner.run(cmd, on_line, on_done, admin=True, password=self.password)
        self.need_password(why, go)

    def find(self):
        found = []

        def go():
            self.log_clear()
            self.busy(True, "Looking for printers ...")

            def on_line(ln, partial):
                if not partial:
                    self.log_add(ln)
                    parts = ln.split()
                    if len(parts) >= 2 and parts[0] in ("network", "direct") and "://" in parts[1] and parts[1].split(":")[0] in ("ipp", "ipps", "dnssd", "usb", "socket"):
                        found.append(parts[1])

            def on_done(rc, err):
                self.busy(False)
                self.show_found(sorted(set(found)))
            self.runner.run(["lpinfo", "-v"], on_line, on_done, admin=True, password=self.password)
        self.need_password("Soarix needs your password to look for printers.", go)

    def show_found(self, uris):
        if not uris:
            self.status.set_text("No printers were found. Check that the printer is on and connected.")
            return
        self.status.set_text("Found %d. Press Add next to the one you want." % len(uris))
        box = self.listbox
        while box.get_first_child():
            box.remove(box.get_first_child())
        for u in uris:
            r = mk(Gtk.Box(spacing=12), "approw")
            r.append(label(u, "label-val", wrap=True))
            r.get_first_child().set_hexpand(True)
            b = mk(Gtk.Button(label="Add"), "primary")
            b.connect("clicked", lambda _b, uri=u: self.add(uri))
            r.append(b)
            box.append(r)
        back = Gtk.Button(label="Back to my printers", halign=Gtk.Align.START)
        back.connect("clicked", lambda *_: self.load())
        box.append(back)

    def add(self, uri):
        name = re.sub(r"[^A-Za-z0-9_-]+", "_", uri.split("://", 1)[1])[:40].strip("_") or "Printer"
        self.admin(["lpadmin", "-p", name, "-E", "-v", uri, "-m", "everywhere"], "Soarix needs your password to add a printer.",
                   "Adding the printer ...")


def default_subnet():
    """The network this computer is on, for example 192.168.1.0/24."""
    import ipaddress
    dev = ""
    for ln in out_of(["ip", "-4", "-o", "route", "show", "default"]).splitlines():
        parts = ln.split()
        if "dev" in parts:
            dev = parts[parts.index("dev") + 1]
            break
    for ln in out_of(["ip", "-4", "-o", "addr", "show", "dev", dev] if dev else ["ip", "-4", "-o", "addr"]).splitlines():
        parts = ln.split()
        if "inet" in parts:
            try:
                return str(ipaddress.ip_interface(parts[parts.index("inet") + 1]).network)
            except ValueError:
                pass
    return ""


class DevicesPage(Page):
    TITLE = "Network Devices"
    SIZE = (920, 840)

    def __init__(self, app):
        super().__init__(app)
        self.head("Network Devices", "Find computers, printers and other devices on your network.")
        card = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "card")
        card.append(label("Scan this network", "heading"))
        row = Gtk.Box(spacing=10)
        self.range = Gtk.Entry(text=default_subnet(), placeholder_text="for example 192.168.1.0/24", hexpand=True)
        self.range.connect("activate", lambda *_: self.scan())
        self.scan_btn = mk(Gtk.Button(label="Scan"), "primary")
        self.scan_btn.connect("clicked", lambda *_: self.scan())
        row.append(self.range)
        row.append(self.scan_btn)
        card.append(row)
        card.append(label("The scan asks each address whether a device is there. It takes a few seconds and changes nothing.", "sub", wrap=True))
        self.root.append(card)
        self.results = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.set_child(self.results)
        self.root.append(scroll)
        self.state = self.log_area(150)
        self.root.append(self.state)

    def scan(self):
        import ipaddress
        try:
            net = ipaddress.ip_network(self.range.get_text().strip(), strict=False)
        except ValueError:
            self.status.set_text("Type a network like 192.168.1.0/24.")
            return
        if net.version != 4 or net.prefixlen < 16:
            self.status.set_text("That range is too large. Use a /16 or smaller, for example 192.168.1.0/24.")
            return
        cidr = str(net)

        def go():
            self.log_clear()
            self.scan_btn.set_sensitive(False)
            self.busy(True, "Looking for devices on %s ..." % cidr)
            self.lines = []

            def on_line(ln, partial):
                if not partial:
                    self.lines.append(ln)
                    self.log_add(ln)

            def on_done(rc, err):
                self.busy(False)
                self.scan_btn.set_sensitive(True)
                self.show(cidr)
            self.runner.run(["nmap", "-sn", cidr], on_line, on_done, admin=True, password=self.password)
        self.need_password("Soarix needs your password to look at the network.", go)

    def show(self, cidr):
        devs, cur = [], None
        for ln in self.lines:
            m = re.match(r"Nmap scan report for (?:(\S+) \((\S+)\)|(\S+))", ln)
            if m:
                import ipaddress
                try:
                    ipaddress.ip_address(m.group(2) or m.group(3))
                except ValueError:
                    cur = None
                    continue
                cur = {"name": m.group(1) or "", "ip": m.group(2) or m.group(3), "mac": "", "vendor": ""}
                devs.append(cur)
                continue
            m = re.match(r"MAC Address: (\S+)(?: \((.*)\))?", ln)
            if m and cur:
                cur["mac"], cur["vendor"] = m.group(1), m.group(2) or ""
        box = self.results
        while box.get_first_child():
            box.remove(box.get_first_child())
        for d in devs:
            r = mk(Gtk.Box(spacing=14), "approw")
            t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            t.append(label(d["name"] or d["ip"], "label-val"))
            t.append(label("%s   %s   %s" % (d["ip"], d["mac"], d["vendor"]), "sub", wrap=True))
            r.append(t)
            pb = Gtk.Button(label="Ping")
            pb.connect("clicked", lambda _b, ip=d["ip"]: self.tool(["ping", "-c", "4", ip], "Pinging %s ..." % ip, False))
            sb = Gtk.Button(label="Open ports")
            sb.connect("clicked", lambda _b, ip=d["ip"]: self.tool(["nmap", "-F", ip], "Checking the common ports on %s ..." % ip, True))
            r.append(pb)
            r.append(sb)
            box.append(r)
        self.status.set_text("Found %d device%s on %s." % (len(devs), "" if len(devs) == 1 else "s", cidr))

    def tool(self, cmd, text, admin):
        self.log_clear()
        self.busy(True, text)

        def on_line(ln, partial):
            if not partial:
                self.log_add(ln)

        def on_done(rc, err):
            self.busy(False)
            self.status.set_text("Done." if rc == 0 else "Finished with a problem (see the details).")
        self.runner.run(cmd, on_line, on_done, admin=admin, password=self.password)


class UsersPage(Page):
    TITLE = "Users"
    SIZE = (860, 860)

    def __init__(self, app):
        super().__init__(app)
        self.head("Users", "Add people, change passwords and choose who is an administrator.")
        self.me = os.environ.get("USER", "")
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        col.append(self.box)
        add = mk(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "card")
        add.append(label("Add a person", "heading"))
        g = Gtk.Grid(row_spacing=10, column_spacing=16)
        self.full = Gtk.Entry(placeholder_text="Full name", hexpand=True)
        self.user = Gtk.Entry(placeholder_text="Username (lowercase letters and numbers)", hexpand=True)
        self.pw = Gtk.PasswordEntry(show_peek_icon=True, hexpand=True)
        self.pw.set_property("placeholder-text", "Password (at least 8 characters)") if hasattr(self.pw.props, "placeholder_text") else None
        self.adm = Gtk.CheckButton(label="Administrator (can install and change the system)")
        for i, (t, w) in enumerate((("Full name", self.full), ("Username", self.user), ("Password", self.pw))):
            g.attach(label(t, "label-key"), 0, i, 1, 1)
            g.attach(w, 1, i, 1, 1)
        g.attach(self.adm, 1, 3, 1, 1)
        add.append(g)
        mkb = mk(Gtk.Button(label="Add this person", halign=Gtk.Align.START), "primary")
        mkb.connect("clicked", lambda *_: self.add_user())
        add.append(mkb)
        col.append(add)
        scroll.set_child(col)
        self.root.append(scroll)
        self.state = self.log_area(90)
        self.root.append(self.state)
        self.load()

    def people(self):
        admins = set()
        for ln in out_of(["getent", "group", "wheel"]).splitlines():
            admins.update(ln.rsplit(":", 1)[-1].split(","))
        out = []
        for ln in out_of(["getent", "passwd"]).splitlines():
            p = ln.split(":")
            if len(p) >= 7 and p[2].isdigit() and 1000 <= int(p[2]) < 60000 and not p[6].endswith(("nologin", "false")):
                out.append({"name": p[0], "full": p[4].split(",")[0], "admin": p[0] in admins})
        return out

    def load(self):
        b = self.box
        while b.get_first_child():
            b.remove(b.get_first_child())
        for u in self.people():
            r = mk(Gtk.Box(spacing=12), "approw")
            t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            t.append(label(u["full"] or u["name"], "label-val"))
            t.append(label("%s   %s%s" % (u["name"], "Administrator" if u["admin"] else "Standard", "   (you)" if u["name"] == self.me else ""), "sub"))
            r.append(t)
            pw = Gtk.Button(label="Change password")
            pw.connect("clicked", lambda _b, n=u["name"]: self.change_pw(n))
            r.append(pw)
            if u["name"] != self.me:
                ad = Gtk.Button(label="Remove administrator" if u["admin"] else "Make administrator")
                ad.connect("clicked", lambda _b, n=u["name"], a=u["admin"]: self.set_admin(n, not a))
                r.append(ad)
                rm = Gtk.Button(label="Remove")
                rm.connect("clicked", lambda _b, n=u["name"]: self.remove(n))
                r.append(rm)
            b.append(r)

    def admin(self, cmd, stdin, why, busy_text, done_text):
        def go():
            self.log_clear()
            self.busy(True, busy_text)

            def on_line(ln, partial):
                if not partial:
                    self.log_add(ln)

            def on_done(rc, err):
                self.busy(False)
                self.status.set_text(done_text if rc == 0 else "That did not work (see the details).")
                self.load()
            self.runner.run(cmd, on_line, on_done, admin=True, password=self.password, extra_stdin=stdin)
        self.need_password(why, go)

    def add_user(self):
        user, full, pw = self.user.get_text().strip(), self.full.get_text().strip(), self.pw.get_text()
        if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,30}", user) or user in ("root", "admin", "guest", "nobody", "install", "daemon", "bin", "sys"):
            self.status.set_text("The username must be lowercase letters and numbers, starting with a letter (not a system name).")
            return
        if len(pw) < 8:
            self.status.set_text("The password needs at least 8 characters.")
            return
        full = re.sub(r"[^A-Za-z0-9 .'-]", "", full)
        import shlex
        cmd = "useradd -m -c %s %s %s && chpasswd" % (shlex.quote(full or user), "-G wheel" if self.adm.get_active() else "", shlex.quote(user))
        self.admin(["sh", "-c", cmd], user + ":" + pw + "\n", "Soarix needs your password to add a person.", "Adding %s ..." % user,
                   "%s was added. They can sign in now." % user)
        self.pw.set_text("")

    def change_pw(self, name):
        dlg = Gtk.Window(transient_for=self, modal=True, title="New password")
        mk(dlg, "soarix-dialog")
        dlg.set_default_size(420, -1)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        for m in ("top", "bottom", "start", "end"):
            getattr(box, "set_margin_" + m)(24)
        box.append(label("New password for %s" % name, "heading", wrap=True))
        e1 = Gtk.PasswordEntry(show_peek_icon=True)
        e2 = Gtk.PasswordEntry(show_peek_icon=True)
        msg = label("", "bad")
        for w in (e1, e2, msg):
            box.append(w)
        row = Gtk.Box(spacing=10, halign=Gtk.Align.END)
        c = Gtk.Button(label="Cancel")
        c.connect("clicked", lambda *_: dlg.close())
        ok = mk(Gtk.Button(label="Change password"), "primary")

        def go(*_):
            if len(e1.get_text()) < 8:
                msg.set_text("At least 8 characters.")
            elif e1.get_text() != e2.get_text():
                msg.set_text("The two passwords do not match.")
            else:
                pw = e1.get_text()
                dlg.close()
                self.admin(["chpasswd"], name + ":" + pw + "\n", "Soarix needs your password to change a password.",
                           "Changing the password ...", "The password for %s was changed." % name)
        ok.connect("clicked", go)
        row.append(c)
        row.append(ok)
        box.append(row)
        dlg.set_child(box)
        dlg.present()

    def set_admin(self, name, make):
        cmd = ["usermod", "-aG", "wheel", name] if make else ["gpasswd", "-d", name, "wheel"]
        self.admin(cmd, None, "Soarix needs your password to change who is an administrator.", "Saving ...",
                   "%s is now %s." % (name, "an administrator" if make else "a standard user"))

    def remove(self, name):
        dlg = Gtk.Window(transient_for=self, modal=True, title="Remove %s?" % name)
        mk(dlg, "soarix-dialog")
        dlg.set_default_size(440, -1)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        for m in ("top", "bottom", "start", "end"):
            getattr(box, "set_margin_" + m)(24)
        box.append(label("Remove %s?" % name, "heading", wrap=True))
        files = Gtk.CheckButton(label="Also delete their files")
        box.append(files)
        row = Gtk.Box(spacing=10, halign=Gtk.Align.END)
        c = Gtk.Button(label="Cancel")
        c.connect("clicked", lambda *_: dlg.close())
        ok = mk(Gtk.Button(label="Remove"), "primary")

        def go(*_):
            keep = files.get_active()
            dlg.close()
            self.admin(["userdel"] + (["-r"] if keep else []) + [name], None, "Soarix needs your password to remove a person.",
                       "Removing %s ..." % name, "%s was removed." % name)
        ok.connect("clicked", go)
        row.append(c)
        row.append(ok)
        box.append(row)
        dlg.set_child(box)
        dlg.present()


class AddonsPage(Page):
    TITLE = "Add-ons"
    SIZE = (860, 780)
    TAGS = {"installed": "Installed", "available": "Available", "coming": "Coming soon", "edition": "Other edition", "key": "Needs a key"}

    def __init__(self, app):
        super().__init__(app)
        self.head("Add-ons", "Extra software that is not for the general public. Your license key decides what you can add.")
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.set_child(self.box)
        self.root.append(scroll)
        self.state = self.log_area(110)
        self.root.append(self.state)
        row = Gtk.Box(spacing=10)
        up = Gtk.Button(label="Update all add-ons")
        up.connect("clicked", lambda *_: self.admin(["soarix-addon", "update"], "Soarix needs your password to update add-ons.",
                                                     "Updating add-ons ...", "Your add-ons are up to date."))
        store = Gtk.Button(label="Open the Store (public apps)")
        store.connect("clicked", lambda *_: subprocess.Popen(["soarix-store"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                                              stderr=subprocess.DEVNULL, start_new_session=True))
        row.append(up)
        row.append(store)
        self.root.append(row)
        self.load()

    def load(self):
        b = self.box
        while b.get_first_child():
            b.remove(b.get_first_child())
        rows = cli_json("soarix-addon", "list", "--json")
        rows = rows if isinstance(rows, list) else []
        for a in rows:
            r = mk(Gtk.Box(spacing=14), "card")
            t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, hexpand=True)
            t.append(label(a["name"], "heading"))
            t.append(label(a["description"], "sub", wrap=True))
            if a["note"]:
                t.append(label(a["note"], "warn", wrap=True))
            if a["version"]:
                t.append(label("Version " + a["version"], "sub"))
            r.append(t)
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, valign=Gtk.Align.CENTER)
            tag = mk(Gtk.Label(label=self.TAGS.get(a["state"], a["state"])), "tag")
            if a["state"] != "installed":
                tag.add_css_class("tag-off")
            col.append(tag)
            if a["state"] == "available":
                ib = mk(Gtk.Button(label="Install"), "primary")
                ib.connect("clicked", lambda _b, i=a["id"], n=a["name"]: self.admin(["soarix-addon", "install", i],
                                                                                  "Soarix needs your password to install %s." % n,
                                                                                  "Installing %s ..." % n, "%s is installed." % n))
                col.append(ib)
            elif a["state"] == "installed":
                rb = Gtk.Button(label="Remove")
                rb.connect("clicked", lambda _b, i=a["id"], n=a["name"]: self.admin(["soarix-addon", "remove", i],
                                                                                  "Soarix needs your password to remove %s." % n,
                                                                                  "Removing %s ..." % n, "%s was removed." % n))
                col.append(rb)
            elif a["state"] == "key":
                kb = Gtk.Button(label="Enter a key")
                kb.connect("clicked", lambda *_: subprocess.Popen(["soarix-window", "sysinfo"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                                                   stderr=subprocess.DEVNULL, start_new_session=True))
                col.append(kb)
            r.append(col)
            b.append(r)
        if not rows:
            b.append(label("No add-ons are listed yet.", "sub"))

    def admin(self, cmd, why, busy_text, done_text):
        def go():
            self.log_clear()
            self.busy(True, busy_text)

            def on_line(ln, partial):
                if not partial:
                    self.log_add(ln)
                self.status.set_text(ln[:140])

            def on_done(rc, err):
                self.busy(False)
                self.status.set_text(done_text if rc == 0 else "That did not work (see the details).")
                self.load()
            self.runner.run(cmd, on_line, on_done, admin=True, password=self.password)
        self.need_password(why, go)


PAGES = {"update": UpdatePage, "license": LicensePage, "essentials": EssentialsPage, "datetime": DateTimePage,
         "sysinfo": SysInfoPage, "services": ServicesPage, "appearance": AppearancePage, "display": DisplayPage,
         "network": NetworkPage, "printers": PrintersPage,
         "devices": DevicesPage, "users": UsersPage, "addons": AddonsPage}


def main():
    page = sys.argv[1] if len(sys.argv) > 1 else ""
    if page not in PAGES:
        print(__doc__)
        return 2
    app = Gtk.Application(application_id="com.soarix.%s" % page, flags=Gio.ApplicationFlags.NON_UNIQUE)

    def activate(a):
        prov = Gtk.CssProvider()
        prov.load_from_string(css(accent()))
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)
        PAGES[page](a).present()
    app.connect("activate", activate)
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
