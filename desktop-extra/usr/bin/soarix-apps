#!/bin/bash
# soarix-apps - the Soarix app drawer (press again, or Esc, to close it)
if pgrep -x nwg-drawer >/dev/null; then pkill -x nwg-drawer; exit 0; fi
mkdir -p "$HOME/.config/nwg-drawer" "$HOME/.cache"
cp -f /etc/soarix/drawer.css "$HOME/.config/nwg-drawer/drawer.css"
# First time: pin the Soarix apps and the store along the top of the drawer
[ -s "$HOME/.cache/nwg-pin-cache" ] || printf '%s\n' \
    soarix-update.desktop soarix-license.desktop soarix-web-console.desktop org.gnome.Software.desktop \
    org.gnome.Nautilus.desktop firefox.desktop > "$HOME/.cache/nwg-pin-cache"
# Newer pinned apps are added for existing users too
for p in soarix-display.desktop soarix-appearance.desktop soarix-essentials.desktop org.remmina.Remmina.desktop; do
    grep -qx "$p" "$HOME/.cache/nwg-pin-cache" || echo "$p" >> "$HOME/.cache/nwg-pin-cache"
done
exec nwg-drawer -ovl -c 8 -is 112 -fscol 8 -term foot -fm nautilus -s drawer.css
