#!/bin/bash
# soarix-power - full-screen power menu (lock, log out, sleep, restart, shut down)
if pgrep -x wlogout >/dev/null; then pkill -x wlogout; exit 0; fi
if command -v wlogout >/dev/null 2>&1; then
    exec wlogout -p layer-shell -l /etc/soarix/wlogout/layout -C /etc/soarix/wlogout/style.css -b 5 -m 0
fi
# fallback: plain list
choice=$(printf 'Lock\nLog out\nSleep\nRestart\nShut down\n' | fuzzel --dmenu --prompt 'Power: ' --lines 5) || exit 0
case "$choice" in
  "Lock")      swaylock -f -c 0b1426 ;;
  "Log out")   niri msg action quit --skip-confirmation ;;
  "Sleep")     systemctl suspend ;;
  "Restart")   systemctl reboot ;;
  "Shut down") systemctl poweroff ;;
esac
