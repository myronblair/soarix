# Soarix Desktop: the Soarix core plus the Strip (niri) desktop session.
# Delivered to installed systems by `sudo soarix-desktop on`.
ARG BASE=localhost/soarix:latest
FROM scratch AS ctx
COPY desktop /

FROM ${BASE}
LABEL org.opencontainers.image.source="https://github.com/myronblair/soarix"
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/desktop.sh
# Finishing touches (session start, app drawer): a small layer of its own, so a tweak here
# ships as a few kilobytes to installed systems instead of re-sending the whole desktop.
COPY desktop-extra/ /
RUN chmod 0755 /usr/bin/soarix-session /usr/bin/soarix-apps
RUN bootc container lint
