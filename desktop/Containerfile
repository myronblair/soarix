# Soarix Desktop: the Soarix core plus the Strip (niri) desktop session.
# Delivered to installed systems by `sudo soarix-desktop on`.
ARG BASE=localhost/soarix:latest
FROM scratch AS ctx
COPY desktop /

FROM ${BASE}
ARG SOARIX_VERSION=0.2.1
LABEL org.opencontainers.image.source="https://github.com/myronblair/soarix" 
      org.opencontainers.image.version="${SOARIX_VERSION}"
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/desktop.sh
# Finishing touches (session start, app drawer): a small layer of its own, so a tweak here
# ships as a few kilobytes to installed systems instead of re-sending the whole desktop.
RUN dnf5 -y install wlogout && dnf5 clean all
COPY desktop-extra/ /
RUN chmod 0755 /usr/bin/soarix-session /usr/bin/soarix-apps /usr/bin/soarix-store /usr/bin/soarix-power /usr/bin/soarix-display /usr/bin/soarix-appearance /usr/bin/soarix-essentials /usr/bin/soarix-window
# Niri's stock config also starts Fedora's default bar; the Soarix bar (started further down
# the same file) is the only one wanted, so drop the stock line.
RUN sed -i '/^spawn-at-startup "waybar"$/d' /etc/niri/config.kdl
# Apply the saved screen resolution (or a sensible default in a virtual machine) at login
RUN echo 'spawn-at-startup "soarix-display" "apply"' >> /etc/niri/config.kdl
# Keep the app drawer to useful apps: hide terminals nobody opens by hand and the Bluetooth adapter page
RUN for f in Alacritty foot-server footclient blueman-adapters; do sed -i '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nNoDisplay=true/' /usr/share/applications/$f.desktop; done
# Tools an IT person expects on a desktop: remote desktop client (RDP/VNC), VPN support in the network settings
RUN dnf5 -y install --skip-unavailable remmina remmina-plugins-rdp remmina-plugins-vnc remmina-plugins-secret NetworkManager-openvpn-gnome openvpn wireguard-tools && dnf5 clean all
# No first-login pop-up of niri's key list
RUN sed -i 's|// skip-at-startup|skip-at-startup|' /etc/niri/config.kdl
# Lock screen (with a clock), automatic lock and screen saver, and the Appearance settings.
RUN dnf5 -y install gtklock swayidle && dnf5 clean all
RUN sed -i 's|^spawn-at-startup "waybar" "-c" .*|spawn-at-startup "soarix-appearance" "bar"\nspawn-at-startup "soarix-appearance" "apply"\nspawn-at-startup "soarix-display" "idle"|; s|spawn "swaylock"|spawn "soarix-display" "lock"|; s|Lock the Screen: swaylock|Lock the Screen|' /etc/niri/config.kdl
RUN bootc container lint
