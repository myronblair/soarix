# Soarix Server: the Soarix desktop image (so the desktop, wallpaper and every Soarix app are included)
# plus a complete traditional hosting stack.
# Everything is installed but switched off; turn pieces on with `soarix-server enable <group>`.
ARG BASE=localhost/soarix-desktop:latest
FROM scratch AS ctx
COPY server /

FROM ${BASE}
ARG SOARIX_VERSION=0.3.3
LABEL org.opencontainers.image.source="https://github.com/myronblair/soarix" \
      org.opencontainers.image.version="${SOARIX_VERSION}"
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/server.sh
RUN bootc container lint
