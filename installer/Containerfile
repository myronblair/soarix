# Soarix installer environment: the live system the installer ISO boots into.
# Built from Fedora's bootc image plus Anaconda; the Soarix core image is downloaded from the license server.
# Build from the repository root:  podman build -f installer/Containerfile -t localhost/soarix-installer .
FROM quay.io/fedora/fedora-bootc:44

# Neutral branding so the installer says Soarix, not Fedora
RUN dnf5 -y install --allowerasing generic-release generic-logos

RUN dnf5 -y install \
    anaconda anaconda-install-img-deps anaconda-dracut \
    dracut-config-generic dracut-network dracut-live \
    net-tools grub2-efi-x64-cdboot grub2-common grub2-pc-modules \
    plymouth default-fonts-core-sans default-fonts-other-sans google-noto-sans-cjk-fonts \
    xorriso squashfs-tools isomd5sum jq skopeo podman \
 && dnf5 clean all

RUN printf '%s\n' 'NAME="Soarix"' 'PRETTY_NAME="Soarix 0.1"' 'ID=soarix' 'ID_LIKE="fedora"' \
    'VERSION="0.1"' 'VERSION_ID="0.1"' 'VARIANT_ID=installer' 'HOME_URL="https://getsoarix.com"' \
    > /usr/lib/os-release && ln -sf ../usr/lib/os-release /etc/os-release

# Product identity the installer reads (this is what the title bar says)
RUN printf '[Main]\nProduct=Soarix\nVersion=0.1\nBugURL=https://getsoarix.com\nIsFinal=True\nUUID=202611171200.x86_64\n\n[Compose]\nLorax=soarix\n' > /.buildstamp

# Soarix look: artwork (sidebar, header, splash) and colours
COPY branding/png/sidebar-logo.png branding/png/sidebar-bg.png branding/png/topbar-bg.png \
     branding/png/anaconda_header.png branding/png/splash.png branding/png/progress_first.png \
     /usr/share/anaconda/pixmaps/
COPY branding/png/mark-256.png /usr/share/pixmaps/soarix-logo.png
COPY installer/soarix-gtk.css /tmp/soarix-gtk.css
RUN for f in fedora-logo.png fedora-logo-small.png; do cp -f /usr/share/pixmaps/soarix-logo.png /usr/share/pixmaps/$f; done; \
    rm -f /usr/share/pixmaps/fedora-logo-sprite.svg /usr/share/pixmaps/bootloader/fedora.icns; \
    sed -i 's/^@define-color anaconda_bg_color .*/@define-color anaconda_bg_color #0b1220;/' /usr/share/anaconda/anaconda-gtk.css && \
    cat /tmp/soarix-gtk.css >> /usr/share/anaconda/anaconda-gtk.css && rm -f /tmp/soarix-gtk.css

# Boot files the ISO builder expects
RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

# Installer boot menu: command line is the default; the second entry also fetches the desktop
COPY installer/iso.yaml /usr/lib/image-builder/bootc/iso.yaml

# Stage the OS image on the new disk (not in RAM) at the moment bootc runs
COPY installer/soarix-bootc-wrapper /usr/libexec/soarix/bootc-wrapper
RUN mv /usr/bin/bootc /usr/libexec/soarix/bootc.real && \
    install -m 755 /usr/libexec/soarix/bootc-wrapper /usr/bin/bootc

# License key: asked and activated before the installer starts (the ISO carries no operating system)
COPY installer/soarix-license-prompt /usr/libexec/soarix/license-prompt
COPY installer/soarix-license.service /usr/lib/systemd/system/soarix-license.service
RUN chmod 755 /usr/libexec/soarix/license-prompt && \
    mkdir -p /usr/lib/systemd/system/anaconda.target.wants /usr/lib/systemd/system/anaconda.service.d && \
    ln -sf ../soarix-license.service /usr/lib/systemd/system/anaconda.target.wants/soarix-license.service && \
    printf '[Unit]\nRequires=soarix-license.service\nAfter=soarix-license.service\n' > /usr/lib/systemd/system/anaconda.service.d/10-soarix-license.conf

# What the installer installs (the OS image is downloaded from the license server during the install)
COPY installer/interactive-defaults.ks /usr/share/anaconda/interactive-defaults.ks

# Minimum plumbing normally done by lorax to make Anaconda run
RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd && \
    echo "install::14438:0:99999:7:::" >> /etc/shadow && \
    passwd -d root
RUN mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives && \
    mv /etc/yum.repos.d /etc/anaconda.repos.d && \
    ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target && \
    rm -v /usr/lib/systemd/system-generators/systemd-gpt-auto-generator
RUN ln -sf /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service
RUN mkdir -p /usr/lib/systemd/logind.conf.d && printf '[Login]\nReserveVT=2\n' > /usr/lib/systemd/logind.conf.d/anaconda-shell.conf
RUN mkdir -p /etc/systemd/user/pipewire.service.d /etc/systemd/user/pipewire.socket.d && \
    printf '[Unit]\nConditionUser=\n' > /etc/systemd/user/pipewire.service.d/allowroot.conf && \
    printf '[Unit]\nConditionUser=\n' > /etc/systemd/user/pipewire.socket.d/allowroot.conf

# The braille-display service retries a missing USB device in a tight loop, flooding the
# installer with events until the screen freezes (the progress spinner stops, Reboot hangs)
RUN for u in brltty.service brltty-udev.service brltty@.service; do ln -sf /dev/null /usr/lib/systemd/system/$u; done; \
    rm -f /usr/lib/udev/rules.d/*brltty*.rules

# Rebuild the boot-time image with live-disc and Anaconda support
RUN mkdir -p "$(realpath /root)" && \
    kernel=$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version') && \
    DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
        --add "anaconda dmsquash-live" \
        --include /.buildstamp /.buildstamp \
        "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"
