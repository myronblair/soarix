[Unit]
Description=Fetch the Soarix desktop or server edition if the installer asked for it
ConditionPathExistsGlob=/var/lib/soarix/want-*
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# A wrong clock makes security certificates look invalid, so set it before downloading anything.
ExecStartPre=-/usr/bin/chronyc -a makestep
# Show what is happening on the screen too: the download takes minutes and the screen would otherwise be blank.
StandardOutput=journal+console
StandardError=journal+console
ExecStart=/usr/libexec/soarix-firstboot-desktop
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
