[Unit]
Description=Fetch the Soarix desktop if the installer asked for it
ConditionPathExists=/var/lib/soarix/want-desktop
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/soarix-firstboot-desktop
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
