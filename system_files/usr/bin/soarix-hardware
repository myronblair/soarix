#!/usr/bin/env python3
"""soarix-hardware - what hardware this computer has, and whether each part has a working driver.

  soarix-hardware            full report
  soarix-hardware --problems only devices that need attention
"""
import os
import re
import shutil
import subprocess
import sys


def run(cmd):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
        return r.stdout.strip()
    except Exception:
        return ""


def have(c):
    return shutil.which(c) is not None


def read(p):
    try:
        return open(p).read().strip()
    except OSError:
        return ""


def pci_devices():
    """Parse 'lspci -k' into (slot, description, driver or None)."""
    out, devs, cur = run(["lspci", "-k"]), [], None
    for line in out.splitlines():
        if line and not line[0].isspace():
            if cur:
                devs.append(cur)
            slot, _, desc = line.partition(" ")
            cur = [slot, desc, None]
        elif "Kernel driver in use:" in line and cur:
            cur[2] = line.split(":", 1)[1].strip()
    if cur:
        devs.append(cur)
    return devs


def section(t):
    print("\n== %s ==" % t)


def main(a):
    problems_only = "--problems" in a
    problems = []

    if not problems_only:
        section("System")
        print("  %s %s" % (read("/sys/class/dmi/id/sys_vendor"), read("/sys/class/dmi/id/product_name")))
        print("  Firmware: %s %s" % (read("/sys/class/dmi/id/bios_vendor"), read("/sys/class/dmi/id/bios_version")))
        print("  Boot: %s   Secure Boot: %s" % ("UEFI" if os.path.isdir("/sys/firmware/efi") else "BIOS",
                                               (run(["mokutil", "--sb-state"]) or "unknown") if have("mokutil") else "unknown"))
        cpu = next((l.split(":", 1)[1].strip() for l in open("/proc/cpuinfo") if l.startswith("model name")), "unknown")
        mem = next((int(l.split()[1]) // 1024 for l in open("/proc/meminfo") if l.startswith("MemTotal")), 0)
        print("  CPU: %s   Memory: %d MB" % (cpu, mem))

    devs = pci_devices() if have("lspci") else []
    if not problems_only:
        section("Graphics")
        for slot, desc, drv in devs:
            if re.search(r"VGA|3D controller|Display controller", desc):
                print("  %s  [driver: %s]" % (desc, drv or "NONE"))
        section("Network, Wi-Fi and Bluetooth")
        for slot, desc, drv in devs:
            if re.search(r"Ethernet|Network controller|Wireless", desc):
                print("  %s  [driver: %s]" % (desc, drv or "NONE"))
        if have("rfkill"):
            for l in run(["rfkill", "list"]).splitlines():
                if not l.startswith("\t"):
                    print("  radio:", l)
        section("Audio")
        for slot, desc, drv in devs:
            if re.search(r"Audio|Multimedia", desc):
                print("  %s  [driver: %s]" % (desc, drv or "NONE"))
        section("Storage")
        if have("lsblk"):
            print(run(["lsblk", "-d", "-o", "NAME,SIZE,TYPE,MODEL"]))
        section("Printers")
        print(run(["lpstat", "-p"]) or "  none set up (add one with the desktop's Printers settings, or lpadmin)") if have("lpstat") else print("  print system not installed")

    for slot, desc, drv in devs:
        if drv is None and not re.search(r"Host bridge|ISA bridge|PCI bridge|SMBus|Signal processing|RAM memory|Non-Essential|Performance counters|System peripheral", desc):
            problems.append("PCI %s %s - no driver loaded" % (slot, desc))
    if have("rfkill"):
        for l in run(["rfkill", "list"]).splitlines():
            if "blocked: yes" in l and "Hard" in l:
                problems.append("a radio is switched off by a hardware switch (%s)" % l.strip())
    if have("fwupdmgr"):
        if "No updatable devices" not in run(["fwupdmgr", "get-devices", "--no-unreported-check"])[:2000]:
            pass

    section("Needs attention")
    if problems:
        for p in problems:
            print("  - " + p)
        print("\n  Updates (kernel, firmware and drivers) arrive with:  soarix-update os")
        print("  Firmware for BIOS / SSD / docks:  fwupdmgr get-updates")
    else:
        print("  Nothing - every detected device has a driver.")


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
    else:
        main(sys.argv[1:])
